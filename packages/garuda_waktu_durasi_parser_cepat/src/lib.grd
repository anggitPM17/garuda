modul DurasiParserCepat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriDurasiParserCepat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur DurasiParserCepat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriDurasiParserCepat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): DurasiParserCepat {
    kembalikan DurasiParserCepat(
        identitas_modul = "DurasiParserCepat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: DurasiParserCepat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: DurasiParserCepat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_durasi_parser_cepat(konteks: DurasiParserCepat, parameter: Teks): Hasil[DurasiParserCepat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_durasi_parser_cepat tidak boleh hampa")
    }
    konst konteks_baru = DurasiParserCepat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

