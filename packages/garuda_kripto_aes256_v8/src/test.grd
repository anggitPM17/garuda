modul UjiKriptoAes256V8

impor KriptoAes256V8
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_enkripsi_dan_dekripsi(): Hasil[Hampa, Teks] {
    konst enc = KriptoAes256V8.enkripsi("pesan_rahasia_999", "kunci_32_bytes_panjang_sekali_1")
    konst dec = KriptoAes256V8.dekripsi(enc, "kunci_32_bytes_panjang_sekali_1")
    tegaskan_sama(dec, "pesan_rahasia_999", "Dekripsi harus mengembalikan pesan_rahasia_999")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_kunci_salah(): Hasil[Hampa, Teks] {
    konst enc = KriptoAes256V8.enkripsi("pesan_rahasia_999", "kunci_32_bytes_panjang_sekali_1")
    konst dec = KriptoAes256V8.dekripsi(enc, "kunci_salah")
    tegaskan_sama(dec, "galat", "Kunci salah harus mengembalikan galat")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_masukan_kosong(): Hasil[Hampa, Teks] {
    konst res = KriptoAes256V8.enkripsi("", "kunci")
    tegaskan_sama(res, "galat", "Teks kosong harus mengembalikan galat")
    kembalikan Sukses(hampa)
}
