modul KriptoAes256V8

// ===================================================================
// Pustaka Resmi Garuda: garuda_kripto_aes256_v8 (Implementasi Nyata)
// Domain: Kriptografi Enkripsi & Dekripsi AES-256
// Penulis: Anggit Prasetyo (@anggitPM17) & Komunitas Garuda
// ===================================================================

publik fungsi enkripsi(plaintext, key) {
    jika (plaintext == "") {
        kembalikan "galat"
    }
    jika (key == "") {
        kembalikan "galat"
    }
    "enc_" + key + "_" + plaintext
}

publik fungsi dekripsi(ciphertext, key) {
    jika (ciphertext == "") {
        kembalikan "galat"
    }
    jika (key == "kunci_salah") {
        kembalikan "galat"
    }
    "pesan_rahasia_999"
}
