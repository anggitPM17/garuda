modul DeflateAliranReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriDeflateAliranReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur DeflateAliranReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriDeflateAliranReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): DeflateAliranReaktif {
    kembalikan DeflateAliranReaktif(
        identitas_modul = "DeflateAliranReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: DeflateAliranReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: DeflateAliranReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_deflate_aliran_reaktif(konteks: DeflateAliranReaktif, parameter: Teks): Hasil[DeflateAliranReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_deflate_aliran_reaktif tidak boleh hampa")
    }
    konst konteks_baru = DeflateAliranReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

