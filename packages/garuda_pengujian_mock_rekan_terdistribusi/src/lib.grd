modul MockRekanTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMockRekanTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MockRekanTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMockRekanTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MockRekanTerdistribusi {
    kembalikan MockRekanTerdistribusi(
        identitas_modul = "MockRekanTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MockRekanTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MockRekanTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mock_rekan_terdistribusi(konteks: MockRekanTerdistribusi, parameter: Teks): Hasil[MockRekanTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mock_rekan_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = MockRekanTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

