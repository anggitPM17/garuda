modul HaversineJarakTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHaversineJarakTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HaversineJarakTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHaversineJarakTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HaversineJarakTerdistribusi {
    kembalikan HaversineJarakTerdistribusi(
        identitas_modul = "HaversineJarakTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HaversineJarakTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HaversineJarakTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_haversine_jarak_terdistribusi(konteks: HaversineJarakTerdistribusi, parameter: Teks): Hasil[HaversineJarakTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_haversine_jarak_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = HaversineJarakTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

