modul NtpSinkronKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriNtpSinkronKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur NtpSinkronKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriNtpSinkronKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): NtpSinkronKilat {
    kembalikan NtpSinkronKilat(
        identitas_modul = "NtpSinkronKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: NtpSinkronKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: NtpSinkronKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ntp_sinkron_kilat(konteks: NtpSinkronKilat, parameter: Teks): Hasil[NtpSinkronKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ntp_sinkron_kilat tidak boleh hampa")
    }
    konst konteks_baru = NtpSinkronKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

