modul JejakOpentelemetryNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriJejakOpentelemetryNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur JejakOpentelemetryNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriJejakOpentelemetryNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): JejakOpentelemetryNirblokir {
    kembalikan JejakOpentelemetryNirblokir(
        identitas_modul = "JejakOpentelemetryNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: JejakOpentelemetryNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: JejakOpentelemetryNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_jejak_opentelemetry_nirblokir(konteks: JejakOpentelemetryNirblokir, parameter: Teks): Hasil[JejakOpentelemetryNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_jejak_opentelemetry_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = JejakOpentelemetryNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

