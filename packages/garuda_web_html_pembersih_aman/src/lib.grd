modul HtmlPembersihAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHtmlPembersihAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HtmlPembersihAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHtmlPembersihAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HtmlPembersihAman {
    kembalikan HtmlPembersihAman(
        identitas_modul = "HtmlPembersihAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HtmlPembersihAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HtmlPembersihAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_html_pembersih_aman(konteks: HtmlPembersihAman, parameter: Teks): Hasil[HtmlPembersihAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_html_pembersih_aman tidak boleh hampa")
    }
    konst konteks_baru = HtmlPembersihAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

