modul LexerTokenizerRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLexerTokenizerRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LexerTokenizerRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLexerTokenizerRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LexerTokenizerRdma {
    kembalikan LexerTokenizerRdma(
        identitas_modul = "LexerTokenizerRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LexerTokenizerRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LexerTokenizerRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_lexer_tokenizer_rdma(konteks: LexerTokenizerRdma, parameter: Teks): Hasil[LexerTokenizerRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_lexer_tokenizer_rdma tidak boleh hampa")
    }
    konst konteks_baru = LexerTokenizerRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

