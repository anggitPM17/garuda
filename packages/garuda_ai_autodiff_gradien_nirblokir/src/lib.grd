modul AutodiffGradienNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAutodiffGradienNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AutodiffGradienNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAutodiffGradienNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AutodiffGradienNirblokir {
    kembalikan AutodiffGradienNirblokir(
        identitas_modul = "AutodiffGradienNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AutodiffGradienNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AutodiffGradienNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_autodiff_gradien_nirblokir(konteks: AutodiffGradienNirblokir, parameter: Teks): Hasil[AutodiffGradienNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_autodiff_gradien_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = AutodiffGradienNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

