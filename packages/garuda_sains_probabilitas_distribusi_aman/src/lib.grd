modul ProbabilitasDistribusiAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriProbabilitasDistribusiAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ProbabilitasDistribusiAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriProbabilitasDistribusiAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ProbabilitasDistribusiAman {
    kembalikan ProbabilitasDistribusiAman(
        identitas_modul = "ProbabilitasDistribusiAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ProbabilitasDistribusiAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ProbabilitasDistribusiAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_probabilitas_distribusi_aman(konteks: ProbabilitasDistribusiAman, parameter: Teks): Hasil[ProbabilitasDistribusiAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_probabilitas_distribusi_aman tidak boleh hampa")
    }
    konst konteks_baru = ProbabilitasDistribusiAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

