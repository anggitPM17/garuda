}

publik fungsi apakah_kosong(s: ApiRouterOpenapiPetascale): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_api_router_openapi_petascale(konteks: ApiRouterOpenapiPetascale, parameter: Teks): Hasil[ApiRouterOpenapiPetascale, Teks] {
