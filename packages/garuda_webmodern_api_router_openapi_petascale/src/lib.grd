publik fungsi inisialisasi(): ApiRouterOpenapiPetascale {
    kembalikan ApiRouterOpenapiPetascale(
        identitas_modul = "ApiRouterOpenapiPetascale",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
