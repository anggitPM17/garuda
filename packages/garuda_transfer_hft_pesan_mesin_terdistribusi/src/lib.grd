modul HftPesanMesinTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHftPesanMesinTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HftPesanMesinTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHftPesanMesinTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HftPesanMesinTerdistribusi {
    kembalikan HftPesanMesinTerdistribusi(
        identitas_modul = "HftPesanMesinTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HftPesanMesinTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HftPesanMesinTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_hft_pesan_mesin_terdistribusi(konteks: HftPesanMesinTerdistribusi, parameter: Teks): Hasil[HftPesanMesinTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_hft_pesan_mesin_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = HftPesanMesinTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

