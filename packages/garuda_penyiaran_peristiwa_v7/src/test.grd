modul UjiPenyiaranPeristiwaV7

impor PenyiaranPeristiwaV7
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_langganan_dan_siarkan(): Hasil[Hampa, Teks] {
    konst bus = PenyiaranPeristiwaV7.baru()
    PenyiaranPeristiwaV7.langganan_topik(bus, "topik_utama", "subscriber_1")
    konst s = PenyiaranPeristiwaV7.siarkan_peristiwa(bus, "topik_utama", "pesan_event")
    tegaskan_sama(s, "subscriber_1", "Siarkan harus mengembalikan subscriber_1")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_siarkan_topik_kosong(): Hasil[Hampa, Teks] {
    konst bus = PenyiaranPeristiwaV7.baru()
    konst s = PenyiaranPeristiwaV7.siarkan_peristiwa(bus, "topik_tidak_ada", "pesan")
    tegaskan_sama(s, "galat", "Siarkan topik tidak ada harus mengembalikan galat")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_langganan_kosong(): Hasil[Hampa, Teks] {
    konst bus = PenyiaranPeristiwaV7.baru()
    konst r = PenyiaranPeristiwaV7.langganan_topik(bus, "", "sub")
    tegaskan_sama(r, "galat", "Langganan topik kosong harus mengembalikan galat")
    kembalikan Sukses(hampa)
}
