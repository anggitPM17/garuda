modul PenyiaranPeristiwaV7

// ===================================================================
// Pustaka Resmi Garuda: garuda_penyiaran_peristiwa_v7 (Implementasi Nyata)
// Domain: Pola Desain Bus Peristiwa Pub/Sub berbasis Ets
// Penulis: Anggit Prasetyo (@anggitPM17) & Komunitas Garuda
// ===================================================================

publik fungsi baru() {
    Ets.baru()
}

publik fungsi langganan_topik(bus, topik, subscriber) {
    jika (topik == "") {
        kembalikan "galat"
    }
    Ets.sisip(bus, topik, subscriber)
    kembalikan bus
}

publik fungsi siarkan_peristiwa(bus, topik, pesan) {
    konst sub = Ets.cari(bus, topik)
    jika (sub == nil) {
        kembalikan "galat"
    }
    kembalikan sub
}

publik fungsi hentikan_langganan(bus, topik) {
    Ets.hapus(bus, topik)
    kembalikan bus
}
