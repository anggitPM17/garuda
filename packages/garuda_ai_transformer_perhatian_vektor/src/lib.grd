modul TransformerPerhatianVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTransformerPerhatianVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TransformerPerhatianVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTransformerPerhatianVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TransformerPerhatianVektor {
    kembalikan TransformerPerhatianVektor(
        identitas_modul = "TransformerPerhatianVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TransformerPerhatianVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TransformerPerhatianVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_transformer_perhatian_vektor(konteks: TransformerPerhatianVektor, parameter: Teks): Hasil[TransformerPerhatianVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_transformer_perhatian_vektor tidak boleh hampa")
    }
    konst konteks_baru = TransformerPerhatianVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

