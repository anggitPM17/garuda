modul MockRekanVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMockRekanVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MockRekanVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMockRekanVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MockRekanVektor {
    kembalikan MockRekanVektor(
        identitas_modul = "MockRekanVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MockRekanVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MockRekanVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mock_rekan_vektor(konteks: MockRekanVektor, parameter: Teks): Hasil[MockRekanVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mock_rekan_vektor tidak boleh hampa")
    }
    konst konteks_baru = MockRekanVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

