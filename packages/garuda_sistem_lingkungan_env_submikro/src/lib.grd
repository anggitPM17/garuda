modul LingkunganEnvSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLingkunganEnvSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LingkunganEnvSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLingkunganEnvSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LingkunganEnvSubmikro {
    kembalikan LingkunganEnvSubmikro(
        identitas_modul = "LingkunganEnvSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LingkunganEnvSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LingkunganEnvSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_lingkungan_env_submikro(konteks: LingkunganEnvSubmikro, parameter: Teks): Hasil[LingkunganEnvSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_lingkungan_env_submikro tidak boleh hampa")
    }
    konst konteks_baru = LingkunganEnvSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

