modul ZipArsipReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriZipArsipReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ZipArsipReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriZipArsipReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ZipArsipReaktif {
    kembalikan ZipArsipReaktif(
        identitas_modul = "ZipArsipReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ZipArsipReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ZipArsipReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_zip_arsip_reaktif(konteks: ZipArsipReaktif, parameter: Teks): Hasil[ZipArsipReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_zip_arsip_reaktif tidak boleh hampa")
    }
    konst konteks_baru = ZipArsipReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

