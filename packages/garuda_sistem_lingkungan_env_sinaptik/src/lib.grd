modul LingkunganEnvSinaptik

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLingkunganEnvSinaptik {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LingkunganEnvSinaptik {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLingkunganEnvSinaptik],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LingkunganEnvSinaptik {
    kembalikan LingkunganEnvSinaptik(
        identitas_modul = "LingkunganEnvSinaptik",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LingkunganEnvSinaptik): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LingkunganEnvSinaptik): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_lingkungan_env_sinaptik(konteks: LingkunganEnvSinaptik, parameter: Teks): Hasil[LingkunganEnvSinaptik, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_lingkungan_env_sinaptik tidak boleh hampa")
    }
    konst konteks_baru = LingkunganEnvSinaptik(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

