modul LexerTokenizerAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLexerTokenizerAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LexerTokenizerAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLexerTokenizerAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LexerTokenizerAman {
    kembalikan LexerTokenizerAman(
        identitas_modul = "LexerTokenizerAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LexerTokenizerAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LexerTokenizerAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_lexer_tokenizer_aman(konteks: LexerTokenizerAman, parameter: Teks): Hasil[LexerTokenizerAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_lexer_tokenizer_aman tidak boleh hampa")
    }
    konst konteks_baru = LexerTokenizerAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

