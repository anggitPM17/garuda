modul MemoriNumaVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMemoriNumaVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MemoriNumaVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMemoriNumaVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MemoriNumaVektor {
    kembalikan MemoriNumaVektor(
        identitas_modul = "MemoriNumaVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MemoriNumaVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MemoriNumaVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_memori_numa_vektor(konteks: MemoriNumaVektor, parameter: Teks): Hasil[MemoriNumaVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_memori_numa_vektor tidak boleh hampa")
    }
    konst konteks_baru = MemoriNumaVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

