modul Ll1PenguraiSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLl1PenguraiSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur Ll1PenguraiSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLl1PenguraiSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): Ll1PenguraiSubmikro {
    kembalikan Ll1PenguraiSubmikro(
        identitas_modul = "Ll1PenguraiSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: Ll1PenguraiSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: Ll1PenguraiSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ll1_pengurai_submikro(konteks: Ll1PenguraiSubmikro, parameter: Teks): Hasil[Ll1PenguraiSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ll1_pengurai_submikro tidak boleh hampa")
    }
    konst konteks_baru = Ll1PenguraiSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

