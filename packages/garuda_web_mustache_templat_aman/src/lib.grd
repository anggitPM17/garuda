modul MustacheTemplatAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMustacheTemplatAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MustacheTemplatAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMustacheTemplatAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MustacheTemplatAman {
    kembalikan MustacheTemplatAman(
        identitas_modul = "MustacheTemplatAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MustacheTemplatAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MustacheTemplatAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mustache_templat_aman(konteks: MustacheTemplatAman, parameter: Teks): Hasil[MustacheTemplatAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mustache_templat_aman tidak boleh hampa")
    }
    konst konteks_baru = MustacheTemplatAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

