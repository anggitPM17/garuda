modul PemantauDirektoriAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPemantauDirektoriAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PemantauDirektoriAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPemantauDirektoriAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PemantauDirektoriAman {
    kembalikan PemantauDirektoriAman(
        identitas_modul = "PemantauDirektoriAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PemantauDirektoriAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PemantauDirektoriAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_pemantau_direktori_aman(konteks: PemantauDirektoriAman, parameter: Teks): Hasil[PemantauDirektoriAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_pemantau_direktori_aman tidak boleh hampa")
    }
    konst konteks_baru = PemantauDirektoriAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

