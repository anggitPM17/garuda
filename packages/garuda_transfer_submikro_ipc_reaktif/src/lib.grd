modul SubmikroIpcReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSubmikroIpcReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SubmikroIpcReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSubmikroIpcReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SubmikroIpcReaktif {
    kembalikan SubmikroIpcReaktif(
        identitas_modul = "SubmikroIpcReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SubmikroIpcReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SubmikroIpcReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_submikro_ipc_reaktif(konteks: SubmikroIpcReaktif, parameter: Teks): Hasil[SubmikroIpcReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_submikro_ipc_reaktif tidak boleh hampa")
    }
    konst konteks_baru = SubmikroIpcReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

