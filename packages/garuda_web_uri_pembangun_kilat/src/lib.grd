modul UriPembangunKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriUriPembangunKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur UriPembangunKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriUriPembangunKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): UriPembangunKilat {
    kembalikan UriPembangunKilat(
        identitas_modul = "UriPembangunKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: UriPembangunKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: UriPembangunKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_uri_pembangun_kilat(konteks: UriPembangunKilat, parameter: Teks): Hasil[UriPembangunKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_uri_pembangun_kilat tidak boleh hampa")
    }
    konst konteks_baru = UriPembangunKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

