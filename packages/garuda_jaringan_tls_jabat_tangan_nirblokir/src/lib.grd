modul TlsJabatTanganNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTlsJabatTanganNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TlsJabatTanganNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTlsJabatTanganNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TlsJabatTanganNirblokir {
    kembalikan TlsJabatTanganNirblokir(
        identitas_modul = "TlsJabatTanganNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TlsJabatTanganNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TlsJabatTanganNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tls_jabat_tangan_nirblokir(konteks: TlsJabatTanganNirblokir, parameter: Teks): Hasil[TlsJabatTanganNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tls_jabat_tangan_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = TlsJabatTanganNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

