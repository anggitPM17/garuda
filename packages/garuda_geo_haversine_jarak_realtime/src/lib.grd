modul HaversineJarakRealtime

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHaversineJarakRealtime {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HaversineJarakRealtime {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHaversineJarakRealtime],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HaversineJarakRealtime {
    kembalikan HaversineJarakRealtime(
        identitas_modul = "HaversineJarakRealtime",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HaversineJarakRealtime): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HaversineJarakRealtime): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_haversine_jarak_realtime(konteks: HaversineJarakRealtime, parameter: Teks): Hasil[HaversineJarakRealtime, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_haversine_jarak_realtime tidak boleh hampa")
    }
    konst konteks_baru = HaversineJarakRealtime(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

