modul UjiHttpKlienV7

impor HttpKlienV7
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_ambil_get_invalid(): Hasil[Hampa, Teks] {
    konst res = HttpKlienV7.ambil_get("http://127.0.0.1:1/invalid")
    tegaskan_sama(res, "salah", "Ambil URL invalid harus mengembalikan salah")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_kirim_post_invalid(): Hasil[Hampa, Teks] {
    konst res = HttpKlienV7.kirim_post("http://127.0.0.1:1/invalid")
    tegaskan_sama(res, "salah", "Kirim URL invalid harus mengembalikan salah")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_url_kosong(): Hasil[Hampa, Teks] {
    konst res = HttpKlienV7.ambil_get("")
    tegaskan_sama(res, "galat", "URL kosong harus mengembalikan galat")
    kembalikan Sukses(hampa)
}
