publik fungsi ambil_get(url) {
    jika (url == "") {
        kembalikan "galat"
    }
    Http.ambil(url)
}

publik fungsi kirim_post(url) {
    jika (url == "") {
        kembalikan "galat"
    }
    Http.kirim(url, "")
}
