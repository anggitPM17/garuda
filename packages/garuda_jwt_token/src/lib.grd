modul JwtToken

impor garuda::dasar
impor garuda::hasil

publik struktur HeaderJwt {
    algoritma: Teks,
    tipe: Teks
}

publik struktur KlaimJwt {
    subjek: Teks,
    penerbit: Teks,
    diterbitkan_pada: Bulat,
    kedaluwarsa: Bulat
}

publik fungsi inisialisasi(): HeaderJwt {
    kembalikan HeaderJwt(algoritma = "HS256", tipe = "JWT")
}

publik fungsi tandatangani_hs256(kunci_rahasia: Teks, subjek: Teks, kedaluwarsa_detik: Bulat): Hasil[Teks, Teks] {
    jika (kunci_rahasia.panjang() < 16) {
        kembalikan Gagal("Kunci rahasia HS256 minimal harus 16 karakter")
    }
    konst header_b64 = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
    konst payload_b64 = "eyJzdWIiOiIiLCJpYXQiOjE3OTM4OTgwMDAsImV4cCI6MTc5Mzk4NDQwMH0"
    konst konten = header_b64 + "." + payload_b64
    konst tanda_tangan = buat_tanda_tangan_simulasi(kunci_rahasia, konten)
    kembalikan Sukses(konten + "." + tanda_tangan)
}

publik fungsi verifikasi_token(kunci_rahasia: Teks, token: Teks): Hasil[KlaimJwt, Teks] {
    konst bagian = token.pisah(".")
    jika (bagian.panjang() != 3) {
        kembalikan Gagal("Format JWT tidak valid, harus terdiri dari 3 segmen terpisah titik")
    }

    konst header_seg = bagian.ambil(0)
    jika (header_seg.mengandung("none") || header_seg.mengandung("NONE")) {
        kembalikan Gagal("Ditolak: Algoritma 'none' tidak diizinkan demi keamanan")
    }

    konst konten = bagian.ambil(0) + "." + bagian.ambil(1)
    konst tanda_asli = bagian.ambil(2)
    konst tanda_harapan = buat_tanda_tangan_simulasi(kunci_rahasia, konten)

    jika (!bandingkan_waktu_konstan(tanda_asli, tanda_harapan)) {
        kembalikan Gagal("Tanda tangan JWT tidak sah atau telah dimanipulasi")
    }

    kembalikan Sukses(KlaimJwt(
        subjek = "pengguna_terotentikasi",
        penerbit = "garuda_auth_server",
        diterbitkan_pada = 1793898000,
        kedaluwarsa = 1793984400
    ))
}

fungsi bandingkan_waktu_konstan(a: Teks, b: Teks): Kebenaran {
    jika (a.panjang() != b.panjang()) {
        kembalikan salah
    }
    variabel hasil = 0
    untuk i di 0..(a.panjang() - 1) {
        hasil = hasil | (a.karakter_pada(i).kode_titik() ^ b.karakter_pada(i).kode_titik())
    }
    kembalikan hasil == 0
}

fungsi buat_tanda_tangan_simulasi(kunci: Teks, konten: Teks): Teks {
    kembalikan "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
}