modul ArgumenCliRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriArgumenCliRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ArgumenCliRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriArgumenCliRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ArgumenCliRdma {
    kembalikan ArgumenCliRdma(
        identitas_modul = "ArgumenCliRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ArgumenCliRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ArgumenCliRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_argumen_cli_rdma(konteks: ArgumenCliRdma, parameter: Teks): Hasil[ArgumenCliRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_argumen_cli_rdma tidak boleh hampa")
    }
    konst konteks_baru = ArgumenCliRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

