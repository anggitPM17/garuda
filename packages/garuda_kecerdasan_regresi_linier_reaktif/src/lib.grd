modul RegresiLinierReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRegresiLinierReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RegresiLinierReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRegresiLinierReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RegresiLinierReaktif {
    kembalikan RegresiLinierReaktif(
        identitas_modul = "RegresiLinierReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RegresiLinierReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RegresiLinierReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_regresi_linier_reaktif(konteks: RegresiLinierReaktif, parameter: Teks): Hasil[RegresiLinierReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_regresi_linier_reaktif tidak boleh hampa")
    }
    konst konteks_baru = RegresiLinierReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

