modul TarArsipCepat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTarArsipCepat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TarArsipCepat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTarArsipCepat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TarArsipCepat {
    kembalikan TarArsipCepat(
        identitas_modul = "TarArsipCepat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TarArsipCepat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TarArsipCepat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tar_arsip_cepat(konteks: TarArsipCepat, parameter: Teks): Hasil[TarArsipCepat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tar_arsip_cepat tidak boleh hampa")
    }
    konst konteks_baru = TarArsipCepat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

