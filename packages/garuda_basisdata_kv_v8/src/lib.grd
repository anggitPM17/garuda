modul BasisDataKvV8

// ===================================================================
// Pustaka Resmi Garuda: garuda_basisdata_kv_v8 (Implementasi Nyata)
// Domain: Basis Data Key-Value thread-safe berbasis Ets
// Penulis: Anggit Prasetyo (@anggitPM17) & Komunitas Garuda
// ===================================================================

publik fungsi buka_basisdata(jalur) {
    Ets.baru()
}

publik fungsi simpan_kunci(tid, kunci, nilai) {
    jika (kunci == "") {
        kembalikan "galat"
    }
    Ets.sisip(tid, kunci, nilai)
    kembalikan tid
}

publik fungsi ambil_kunci(tid, kunci) {
    Ets.cari(tid, kunci)
}

publik fungsi hapus_kunci(tid, kunci) {
    Ets.hapus(tid, kunci)
    kembalikan tid
}
