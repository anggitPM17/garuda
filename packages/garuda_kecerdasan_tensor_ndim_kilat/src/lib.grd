modul TensorNdimKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTensorNdimKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TensorNdimKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTensorNdimKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TensorNdimKilat {
    kembalikan TensorNdimKilat(
        identitas_modul = "TensorNdimKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TensorNdimKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TensorNdimKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tensor_ndim_kilat(konteks: TensorNdimKilat, parameter: Teks): Hasil[TensorNdimKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tensor_ndim_kilat tidak boleh hampa")
    }
    konst konteks_baru = TensorNdimKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

