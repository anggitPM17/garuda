modul MmapBinerStreamSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMmapBinerStreamSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MmapBinerStreamSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMmapBinerStreamSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MmapBinerStreamSubmikro {
    kembalikan MmapBinerStreamSubmikro(
        identitas_modul = "MmapBinerStreamSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MmapBinerStreamSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MmapBinerStreamSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mmap_biner_stream_submikro(konteks: MmapBinerStreamSubmikro, parameter: Teks): Hasil[MmapBinerStreamSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mmap_biner_stream_submikro tidak boleh hampa")
    }
    konst konteks_baru = MmapBinerStreamSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

