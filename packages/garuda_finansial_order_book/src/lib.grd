modul FinansialOrderBook

impor garuda::dasar
impor garuda::hasil

publik struktur EntriFinansialOrderBook {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur FinansialOrderBook {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriFinansialOrderBook],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): FinansialOrderBook {
    kembalikan FinansialOrderBook(
        identitas_modul = "FinansialOrderBook",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: FinansialOrderBook): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: FinansialOrderBook): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi pasang_limit_order(konteks: FinansialOrderBook, parameter: Teks): Hasil[FinansialOrderBook, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi pasang_limit_order tidak boleh hampa")
    }
    konst konteks_baru = FinansialOrderBook(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

