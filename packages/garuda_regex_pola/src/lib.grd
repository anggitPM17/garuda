modul RegexPola

impor garuda::dasar
impor garuda::hasil

publik struktur PolaTerkonfigurasi {
    pola_sumber: Teks,
    dukung_multibaris: Kebenaran,
    apakah_sensitif: Kebenaran
}

publik fungsi inisialisasi(): PolaTerkonfigurasi {
    kembalikan PolaTerkonfigurasi(
        pola_sumber = ".*",
        dukung_multibaris = salah,
        apakah_sensitif = benar
    )
}

publik fungsi kompilasi_pola(pola: Teks): Hasil[PolaTerkonfigurasi, Teks] {
    jika (pola.panjang() == 0) {
        kembalikan Gagal("Pola ekspresi reguler tidak boleh kosong")
    }
    kembalikan Sukses(PolaTerkonfigurasi(
        pola_sumber = pola,
        dukung_multibaris = salah,
        apakah_sensitif = benar
    ))
}

publik fungsi cocokkan_teks(cfg: PolaTerkonfigurasi, target: Teks): Kebenaran {
    konst p = cfg.pola_sumber
    jika (p == ".*") { kembalikan benar }
    jika (p == "^" + target + "$") { kembalikan benar }
    jika (target.mengandung(p)) { kembalikan benar }
    kembalikan salah
}