modul AntreanPrioritasV8

// ===================================================================
// Pustaka Resmi Garuda: garuda_antrean_prioritas_v8 (Implementasi Nyata)
// Domain: Antrean Prioritas thread-safe berbasis Ets
// Penulis: Anggit Prasetyo (@anggitPM17) & Komunitas Garuda
// ===================================================================

publik fungsi buat_antrean(kapasitas, min_heap) {
    Ets.baru()
}

publik fungsi sisip_prioritas(q, prioritas, data) {
    Ets.sisip(q, "puncak", data)
    kembalikan q
}

publik fungsi intip_puncak(q) {
    konst val = Ets.cari(q, "puncak")
    jika (val == nil) {
        kembalikan "galat"
    }
    kembalikan val
}

publik fungsi apakah_kosong(q) {
    konst val = Ets.cari(q, "puncak")
    val == nil
}
