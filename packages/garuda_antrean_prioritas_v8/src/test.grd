modul UjiAntreanPrioritasV8

impor AntreanPrioritasV8
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_sisip_dan_intip(): Hasil[Hampa, Teks] {
    konst q = AntreanPrioritasV8.buat_antrean(10, benar)
    konst q2 = AntreanPrioritasV8.sisip_prioritas(q, 1, "tugas_123")
    konst p = AntreanPrioritasV8.intip_puncak(q2)
    tegaskan_sama(p, "tugas_123", "Intip puncak harus mengembalikan tugas_123")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_antrean_kosong(): Hasil[Hampa, Teks] {
    konst q = AntreanPrioritasV8.buat_antrean(10, benar)
    konst p = AntreanPrioritasV8.intip_puncak(q)
    tegaskan_sama(p, "galat", "Intip puncak antrean kosong harus galat")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_apakah_kosong(): Hasil[Hampa, Teks] {
    konst q = AntreanPrioritasV8.buat_antrean(10, benar)
    konst k1 = AntreanPrioritasV8.apakah_kosong(q)
    tegaskan_sama(k1, benar, "Antrean baru harus kosong")
    kembalikan Sukses(hampa)
}
