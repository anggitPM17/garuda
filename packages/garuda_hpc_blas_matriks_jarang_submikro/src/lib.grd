modul BlasMatriksJarangSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriBlasMatriksJarangSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur BlasMatriksJarangSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriBlasMatriksJarangSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): BlasMatriksJarangSubmikro {
    kembalikan BlasMatriksJarangSubmikro(
        identitas_modul = "BlasMatriksJarangSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: BlasMatriksJarangSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: BlasMatriksJarangSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_blas_matriks_jarang_submikro(konteks: BlasMatriksJarangSubmikro, parameter: Teks): Hasil[BlasMatriksJarangSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_blas_matriks_jarang_submikro tidak boleh hampa")
    }
    konst konteks_baru = BlasMatriksJarangSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

