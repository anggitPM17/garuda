modul GameSimpanStatus

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGameSimpanStatus {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GameSimpanStatus {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGameSimpanStatus],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GameSimpanStatus {
    kembalikan GameSimpanStatus(
        identitas_modul = "GameSimpanStatus",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GameSimpanStatus): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GameSimpanStatus): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi simpan_progres_game(konteks: GameSimpanStatus, parameter: Teks): Hasil[GameSimpanStatus, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi simpan_progres_game tidak boleh hampa")
    }
    konst konteks_baru = GameSimpanStatus(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

