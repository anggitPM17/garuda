modul GamePartikelEfek

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGamePartikelEfek {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GamePartikelEfek {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGamePartikelEfek],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GamePartikelEfek {
    kembalikan GamePartikelEfek(
        identitas_modul = "GamePartikelEfek",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GamePartikelEfek): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GamePartikelEfek): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_pemancar_partikel(konteks: GamePartikelEfek, parameter: Teks): Hasil[GamePartikelEfek, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_pemancar_partikel tidak boleh hampa")
    }
    konst konteks_baru = GamePartikelEfek(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

