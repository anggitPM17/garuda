modul MiddlewarePipelineSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMiddlewarePipelineSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MiddlewarePipelineSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMiddlewarePipelineSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MiddlewarePipelineSubmikro {
    kembalikan MiddlewarePipelineSubmikro(
        identitas_modul = "MiddlewarePipelineSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MiddlewarePipelineSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MiddlewarePipelineSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_middleware_pipeline_submikro(konteks: MiddlewarePipelineSubmikro, parameter: Teks): Hasil[MiddlewarePipelineSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_middleware_pipeline_submikro tidak boleh hampa")
    }
    konst konteks_baru = MiddlewarePipelineSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

