modul BytecodeRakitVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriBytecodeRakitVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur BytecodeRakitVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriBytecodeRakitVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): BytecodeRakitVektor {
    kembalikan BytecodeRakitVektor(
        identitas_modul = "BytecodeRakitVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: BytecodeRakitVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: BytecodeRakitVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_bytecode_rakit_vektor(konteks: BytecodeRakitVektor, parameter: Teks): Hasil[BytecodeRakitVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_bytecode_rakit_vektor tidak boleh hampa")
    }
    konst konteks_baru = BytecodeRakitVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

