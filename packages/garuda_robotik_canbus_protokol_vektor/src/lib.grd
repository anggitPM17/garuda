modul CanbusProtokolVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriCanbusProtokolVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur CanbusProtokolVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriCanbusProtokolVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): CanbusProtokolVektor {
    kembalikan CanbusProtokolVektor(
        identitas_modul = "CanbusProtokolVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: CanbusProtokolVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: CanbusProtokolVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_canbus_protokol_vektor(konteks: CanbusProtokolVektor, parameter: Teks): Hasil[CanbusProtokolVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_canbus_protokol_vektor tidak boleh hampa")
    }
    konst konteks_baru = CanbusProtokolVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

