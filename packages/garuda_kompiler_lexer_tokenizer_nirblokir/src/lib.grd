modul LexerTokenizerNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLexerTokenizerNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LexerTokenizerNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLexerTokenizerNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LexerTokenizerNirblokir {
    kembalikan LexerTokenizerNirblokir(
        identitas_modul = "LexerTokenizerNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LexerTokenizerNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LexerTokenizerNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_lexer_tokenizer_nirblokir(konteks: LexerTokenizerNirblokir, parameter: Teks): Hasil[LexerTokenizerNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_lexer_tokenizer_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = LexerTokenizerNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

