modul ArgumenCliReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriArgumenCliReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ArgumenCliReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriArgumenCliReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ArgumenCliReaktif {
    kembalikan ArgumenCliReaktif(
        identitas_modul = "ArgumenCliReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ArgumenCliReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ArgumenCliReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_argumen_cli_reaktif(konteks: ArgumenCliReaktif, parameter: Teks): Hasil[ArgumenCliReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_argumen_cli_reaktif tidak boleh hampa")
    }
    konst konteks_baru = ArgumenCliReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

