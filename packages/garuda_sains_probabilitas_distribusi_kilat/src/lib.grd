modul ProbabilitasDistribusiKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriProbabilitasDistribusiKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ProbabilitasDistribusiKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriProbabilitasDistribusiKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ProbabilitasDistribusiKilat {
    kembalikan ProbabilitasDistribusiKilat(
        identitas_modul = "ProbabilitasDistribusiKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ProbabilitasDistribusiKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ProbabilitasDistribusiKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_probabilitas_distribusi_kilat(konteks: ProbabilitasDistribusiKilat, parameter: Teks): Hasil[ProbabilitasDistribusiKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_probabilitas_distribusi_kilat tidak boleh hampa")
    }
    konst konteks_baru = ProbabilitasDistribusiKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

