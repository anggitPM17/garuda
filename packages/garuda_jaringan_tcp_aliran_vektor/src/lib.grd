modul TcpAliranVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTcpAliranVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TcpAliranVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTcpAliranVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TcpAliranVektor {
    kembalikan TcpAliranVektor(
        identitas_modul = "TcpAliranVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TcpAliranVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TcpAliranVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tcp_aliran_vektor(konteks: TcpAliranVektor, parameter: Teks): Hasil[TcpAliranVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tcp_aliran_vektor tidak boleh hampa")
    }
    konst konteks_baru = TcpAliranVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

