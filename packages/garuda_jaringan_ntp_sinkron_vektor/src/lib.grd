modul NtpSinkronVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriNtpSinkronVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur NtpSinkronVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriNtpSinkronVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): NtpSinkronVektor {
    kembalikan NtpSinkronVektor(
        identitas_modul = "NtpSinkronVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: NtpSinkronVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: NtpSinkronVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ntp_sinkron_vektor(konteks: NtpSinkronVektor, parameter: Teks): Hasil[NtpSinkronVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ntp_sinkron_vektor tidak boleh hampa")
    }
    konst konteks_baru = NtpSinkronVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

