modul SsgIsrBuilderReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSsgIsrBuilderReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SsgIsrBuilderReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSsgIsrBuilderReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SsgIsrBuilderReaktif {
    kembalikan SsgIsrBuilderReaktif(
        identitas_modul = "SsgIsrBuilderReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SsgIsrBuilderReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SsgIsrBuilderReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ssg_isr_builder_reaktif(konteks: SsgIsrBuilderReaktif, parameter: Teks): Hasil[SsgIsrBuilderReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ssg_isr_builder_reaktif tidak boleh hampa")
    }
    konst konteks_baru = SsgIsrBuilderReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

