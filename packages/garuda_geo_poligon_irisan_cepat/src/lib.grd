modul PoligonIrisanCepat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPoligonIrisanCepat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PoligonIrisanCepat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPoligonIrisanCepat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PoligonIrisanCepat {
    kembalikan PoligonIrisanCepat(
        identitas_modul = "PoligonIrisanCepat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PoligonIrisanCepat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PoligonIrisanCepat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_poligon_irisan_cepat(konteks: PoligonIrisanCepat, parameter: Teks): Hasil[PoligonIrisanCepat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_poligon_irisan_cepat tidak boleh hampa")
    }
    konst konteks_baru = PoligonIrisanCepat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

