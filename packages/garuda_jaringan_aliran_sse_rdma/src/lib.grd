modul AliranSseRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAliranSseRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AliranSseRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAliranSseRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AliranSseRdma {
    kembalikan AliranSseRdma(
        identitas_modul = "AliranSseRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AliranSseRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AliranSseRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_aliran_sse_rdma(konteks: AliranSseRdma, parameter: Teks): Hasil[AliranSseRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_aliran_sse_rdma tidak boleh hampa")
    }
    konst konteks_baru = AliranSseRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

