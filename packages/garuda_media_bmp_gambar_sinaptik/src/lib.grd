modul BmpGambarSinaptik

impor garuda::dasar
impor garuda::hasil

publik struktur EntriBmpGambarSinaptik {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur BmpGambarSinaptik {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriBmpGambarSinaptik],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): BmpGambarSinaptik {
    kembalikan BmpGambarSinaptik(
        identitas_modul = "BmpGambarSinaptik",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: BmpGambarSinaptik): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: BmpGambarSinaptik): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_bmp_gambar_sinaptik(konteks: BmpGambarSinaptik, parameter: Teks): Hasil[BmpGambarSinaptik, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_bmp_gambar_sinaptik tidak boleh hampa")
    }
    konst konteks_baru = BmpGambarSinaptik(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

