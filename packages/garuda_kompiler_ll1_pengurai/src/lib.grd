modul Ll1Pengurai

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLl1Pengurai {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur Ll1Pengurai {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLl1Pengurai],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): Ll1Pengurai {
    kembalikan Ll1Pengurai(
        identitas_modul = "Ll1Pengurai",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: Ll1Pengurai): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: Ll1Pengurai): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi inisialisasi(konteks: Ll1Pengurai, parameter: Teks): Hasil[Ll1Pengurai, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi inisialisasi tidak boleh hampa")
    }
    konst konteks_baru = Ll1Pengurai(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

