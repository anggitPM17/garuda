modul RingbufferSpscRealtime

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRingbufferSpscRealtime {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RingbufferSpscRealtime {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRingbufferSpscRealtime],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RingbufferSpscRealtime {
    kembalikan RingbufferSpscRealtime(
        identitas_modul = "RingbufferSpscRealtime",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RingbufferSpscRealtime): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RingbufferSpscRealtime): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ringbuffer_spsc_realtime(konteks: RingbufferSpscRealtime, parameter: Teks): Hasil[RingbufferSpscRealtime, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ringbuffer_spsc_realtime tidak boleh hampa")
    }
    konst konteks_baru = RingbufferSpscRealtime(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

