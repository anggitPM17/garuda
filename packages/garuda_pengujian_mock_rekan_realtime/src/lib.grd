modul MockRekanRealtime

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMockRekanRealtime {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MockRekanRealtime {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMockRekanRealtime],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MockRekanRealtime {
    kembalikan MockRekanRealtime(
        identitas_modul = "MockRekanRealtime",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MockRekanRealtime): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MockRekanRealtime): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mock_rekan_realtime(konteks: MockRekanRealtime, parameter: Teks): Hasil[MockRekanRealtime, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mock_rekan_realtime tidak boleh hampa")
    }
    konst konteks_baru = MockRekanRealtime(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

