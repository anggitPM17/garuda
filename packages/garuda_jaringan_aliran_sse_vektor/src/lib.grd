modul AliranSseVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAliranSseVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AliranSseVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAliranSseVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AliranSseVektor {
    kembalikan AliranSseVektor(
        identitas_modul = "AliranSseVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AliranSseVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AliranSseVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_aliran_sse_vektor(konteks: AliranSseVektor, parameter: Teks): Hasil[AliranSseVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_aliran_sse_vektor tidak boleh hampa")
    }
    konst konteks_baru = AliranSseVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

