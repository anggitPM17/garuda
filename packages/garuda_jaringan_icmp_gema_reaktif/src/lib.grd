modul IcmpGemaReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriIcmpGemaReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur IcmpGemaReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriIcmpGemaReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): IcmpGemaReaktif {
    kembalikan IcmpGemaReaktif(
        identitas_modul = "IcmpGemaReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: IcmpGemaReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: IcmpGemaReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_icmp_gema_reaktif(konteks: IcmpGemaReaktif, parameter: Teks): Hasil[IcmpGemaReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_icmp_gema_reaktif tidak boleh hampa")
    }
    konst konteks_baru = IcmpGemaReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

