modul ProbabilitasDistribusiTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriProbabilitasDistribusiTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ProbabilitasDistribusiTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriProbabilitasDistribusiTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ProbabilitasDistribusiTerdistribusi {
    kembalikan ProbabilitasDistribusiTerdistribusi(
        identitas_modul = "ProbabilitasDistribusiTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ProbabilitasDistribusiTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ProbabilitasDistribusiTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_probabilitas_distribusi_terdistribusi(konteks: ProbabilitasDistribusiTerdistribusi, parameter: Teks): Hasil[ProbabilitasDistribusiTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_probabilitas_distribusi_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = ProbabilitasDistribusiTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

