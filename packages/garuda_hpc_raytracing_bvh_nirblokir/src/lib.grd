modul RaytracingBvhNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRaytracingBvhNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RaytracingBvhNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRaytracingBvhNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RaytracingBvhNirblokir {
    kembalikan RaytracingBvhNirblokir(
        identitas_modul = "RaytracingBvhNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RaytracingBvhNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RaytracingBvhNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_raytracing_bvh_nirblokir(konteks: RaytracingBvhNirblokir, parameter: Teks): Hasil[RaytracingBvhNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_raytracing_bvh_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = RaytracingBvhNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

