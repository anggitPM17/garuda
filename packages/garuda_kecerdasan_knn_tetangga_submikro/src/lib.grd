modul KnnTetanggaSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKnnTetanggaSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KnnTetanggaSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKnnTetanggaSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KnnTetanggaSubmikro {
    kembalikan KnnTetanggaSubmikro(
        identitas_modul = "KnnTetanggaSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KnnTetanggaSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KnnTetanggaSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_knn_tetangga_submikro(konteks: KnnTetanggaSubmikro, parameter: Teks): Hasil[KnnTetanggaSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_knn_tetangga_submikro tidak boleh hampa")
    }
    konst konteks_baru = KnnTetanggaSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

