modul StatistikDeskriptifKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriStatistikDeskriptifKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur StatistikDeskriptifKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriStatistikDeskriptifKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): StatistikDeskriptifKilat {
    kembalikan StatistikDeskriptifKilat(
        identitas_modul = "StatistikDeskriptifKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: StatistikDeskriptifKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: StatistikDeskriptifKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_statistik_deskriptif_kilat(konteks: StatistikDeskriptifKilat, parameter: Teks): Hasil[StatistikDeskriptifKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_statistik_deskriptif_kilat tidak boleh hampa")
    }
    konst konteks_baru = StatistikDeskriptifKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

