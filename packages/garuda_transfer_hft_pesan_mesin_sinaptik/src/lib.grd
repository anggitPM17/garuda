modul HftPesanMesinSinaptik

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHftPesanMesinSinaptik {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HftPesanMesinSinaptik {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHftPesanMesinSinaptik],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HftPesanMesinSinaptik {
    kembalikan HftPesanMesinSinaptik(
        identitas_modul = "HftPesanMesinSinaptik",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HftPesanMesinSinaptik): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HftPesanMesinSinaptik): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_hft_pesan_mesin_sinaptik(konteks: HftPesanMesinSinaptik, parameter: Teks): Hasil[HftPesanMesinSinaptik, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_hft_pesan_mesin_sinaptik tidak boleh hampa")
    }
    konst konteks_baru = HftPesanMesinSinaptik(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

