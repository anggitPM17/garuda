modul MustacheTemplatVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMustacheTemplatVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MustacheTemplatVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMustacheTemplatVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MustacheTemplatVektor {
    kembalikan MustacheTemplatVektor(
        identitas_modul = "MustacheTemplatVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MustacheTemplatVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MustacheTemplatVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mustache_templat_vektor(konteks: MustacheTemplatVektor, parameter: Teks): Hasil[MustacheTemplatVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mustache_templat_vektor tidak boleh hampa")
    }
    konst konteks_baru = MustacheTemplatVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

