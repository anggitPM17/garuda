modul GameUiHud

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGameUiHud {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GameUiHud {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGameUiHud],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GameUiHud {
    kembalikan GameUiHud(
        identitas_modul = "GameUiHud",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GameUiHud): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GameUiHud): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi render_bar_darah(konteks: GameUiHud, parameter: Teks): Hasil[GameUiHud, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi render_bar_darah tidak boleh hampa")
    }
    konst konteks_baru = GameUiHud(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

