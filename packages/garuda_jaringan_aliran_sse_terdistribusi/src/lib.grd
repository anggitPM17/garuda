modul AliranSseTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAliranSseTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AliranSseTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAliranSseTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AliranSseTerdistribusi {
    kembalikan AliranSseTerdistribusi(
        identitas_modul = "AliranSseTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AliranSseTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AliranSseTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_aliran_sse_terdistribusi(konteks: AliranSseTerdistribusi, parameter: Teks): Hasil[AliranSseTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_aliran_sse_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = AliranSseTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

