modul LingkunganEnvAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLingkunganEnvAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LingkunganEnvAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLingkunganEnvAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LingkunganEnvAman {
    kembalikan LingkunganEnvAman(
        identitas_modul = "LingkunganEnvAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LingkunganEnvAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LingkunganEnvAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_lingkungan_env_aman(konteks: LingkunganEnvAman, parameter: Teks): Hasil[LingkunganEnvAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_lingkungan_env_aman tidak boleh hampa")
    }
    konst konteks_baru = LingkunganEnvAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

