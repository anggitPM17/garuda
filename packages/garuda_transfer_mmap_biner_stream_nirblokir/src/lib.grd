modul MmapBinerStreamNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMmapBinerStreamNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MmapBinerStreamNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMmapBinerStreamNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MmapBinerStreamNirblokir {
    kembalikan MmapBinerStreamNirblokir(
        identitas_modul = "MmapBinerStreamNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MmapBinerStreamNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MmapBinerStreamNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mmap_biner_stream_nirblokir(konteks: MmapBinerStreamNirblokir, parameter: Teks): Hasil[MmapBinerStreamNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mmap_biner_stream_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = MmapBinerStreamNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

