modul HftPesanMesinRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHftPesanMesinRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HftPesanMesinRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHftPesanMesinRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HftPesanMesinRdma {
    kembalikan HftPesanMesinRdma(
        identitas_modul = "HftPesanMesinRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HftPesanMesinRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HftPesanMesinRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_hft_pesan_mesin_rdma(konteks: HftPesanMesinRdma, parameter: Teks): Hasil[HftPesanMesinRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_hft_pesan_mesin_rdma tidak boleh hampa")
    }
    konst konteks_baru = HftPesanMesinRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

