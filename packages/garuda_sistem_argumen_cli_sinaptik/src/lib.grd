modul ArgumenCliSinaptik

impor garuda::dasar
impor garuda::hasil

publik struktur EntriArgumenCliSinaptik {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ArgumenCliSinaptik {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriArgumenCliSinaptik],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ArgumenCliSinaptik {
    kembalikan ArgumenCliSinaptik(
        identitas_modul = "ArgumenCliSinaptik",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ArgumenCliSinaptik): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ArgumenCliSinaptik): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_argumen_cli_sinaptik(konteks: ArgumenCliSinaptik, parameter: Teks): Hasil[ArgumenCliSinaptik, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_argumen_cli_sinaptik tidak boleh hampa")
    }
    konst konteks_baru = ArgumenCliSinaptik(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

