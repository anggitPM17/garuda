modul GeojsonPemetaNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGeojsonPemetaNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GeojsonPemetaNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGeojsonPemetaNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GeojsonPemetaNirblokir {
    kembalikan GeojsonPemetaNirblokir(
        identitas_modul = "GeojsonPemetaNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GeojsonPemetaNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GeojsonPemetaNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_geojson_pemeta_nirblokir(konteks: GeojsonPemetaNirblokir, parameter: Teks): Hasil[GeojsonPemetaNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_geojson_pemeta_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = GeojsonPemetaNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

