modul StatistikDeskriptifSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriStatistikDeskriptifSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur StatistikDeskriptifSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriStatistikDeskriptifSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): StatistikDeskriptifSubmikro {
    kembalikan StatistikDeskriptifSubmikro(
        identitas_modul = "StatistikDeskriptifSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: StatistikDeskriptifSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: StatistikDeskriptifSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_statistik_deskriptif_submikro(konteks: StatistikDeskriptifSubmikro, parameter: Teks): Hasil[StatistikDeskriptifSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_statistik_deskriptif_submikro tidak boleh hampa")
    }
    konst konteks_baru = StatistikDeskriptifSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

