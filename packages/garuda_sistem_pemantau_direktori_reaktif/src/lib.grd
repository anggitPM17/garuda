modul PemantauDirektoriReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPemantauDirektoriReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PemantauDirektoriReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPemantauDirektoriReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PemantauDirektoriReaktif {
    kembalikan PemantauDirektoriReaktif(
        identitas_modul = "PemantauDirektoriReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PemantauDirektoriReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PemantauDirektoriReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_pemantau_direktori_reaktif(konteks: PemantauDirektoriReaktif, parameter: Teks): Hasil[PemantauDirektoriReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_pemantau_direktori_reaktif tidak boleh hampa")
    }
    konst konteks_baru = PemantauDirektoriReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

publik fungsi eksekusi_reaktif(konteks: PemantauDirektoriReaktif, parameter: Teks): Hasil[PemantauDirektoriReaktif, Teks] {
    jika (parameter.panjang() == 0) {
