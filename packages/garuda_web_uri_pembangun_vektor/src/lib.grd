modul UriPembangunVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriUriPembangunVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur UriPembangunVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriUriPembangunVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): UriPembangunVektor {
    kembalikan UriPembangunVektor(
        identitas_modul = "UriPembangunVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: UriPembangunVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: UriPembangunVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_uri_pembangun_vektor(konteks: UriPembangunVektor, parameter: Teks): Hasil[UriPembangunVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_uri_pembangun_vektor tidak boleh hampa")
    }
    konst konteks_baru = UriPembangunVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

