modul KontrolerPidReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKontrolerPidReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KontrolerPidReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKontrolerPidReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KontrolerPidReaktif {
    kembalikan KontrolerPidReaktif(
        identitas_modul = "KontrolerPidReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KontrolerPidReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KontrolerPidReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_kontroler_pid_reaktif(konteks: KontrolerPidReaktif, parameter: Teks): Hasil[KontrolerPidReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_kontroler_pid_reaktif tidak boleh hampa")
    }
    konst konteks_baru = KontrolerPidReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

