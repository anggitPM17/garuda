modul Scene3DGaruda

fungsi buat_simpul_3d(NamaNode, PosX, PosY, PosZ) ->
    Simpul = {
        :simpul_3d,
        NamaNode,
        {:posisi_3d, PosX, PosY, PosZ},
        {:skala_3d, 1, 1, 1},
        {:rotasi_3d, 0, 0, 0},
        []
    }
    Simpul
rampung

fungsi hitung_matriks_dunia(Simpul) ->
    {:matriks_dunia, 16}
rampung

fungsi hitung_anak(Simpul) ->
    0
rampung
