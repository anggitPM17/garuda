modul Audio3DGaruda

fungsi buat_pendengar_3d(PosX, PosY, PosZ) ->
    Pendengar = {
        :pendengar_3d,
        {:posisi_3d, PosX, PosY, PosZ},
        {:orientasi_3d, 0, 0, -1}
    }
    Pendengar
rampung

fungsi hitung_peredaman_jarak(Jarak, JarakMaks) ->
    1
rampung

fungsi hitung_sumber_suara(Pendengar) ->
    0
rampung
