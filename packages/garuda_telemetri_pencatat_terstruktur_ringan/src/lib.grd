modul PencatatTerstrukturRingan

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPencatatTerstrukturRingan {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PencatatTerstrukturRingan {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPencatatTerstrukturRingan],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PencatatTerstrukturRingan {
    kembalikan PencatatTerstrukturRingan(
        identitas_modul = "PencatatTerstrukturRingan",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PencatatTerstrukturRingan): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PencatatTerstrukturRingan): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_pencatat_terstruktur_ringan(konteks: PencatatTerstrukturRingan, parameter: Teks): Hasil[PencatatTerstrukturRingan, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_pencatat_terstruktur_ringan tidak boleh hampa")
    }
    konst konteks_baru = PencatatTerstrukturRingan(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

