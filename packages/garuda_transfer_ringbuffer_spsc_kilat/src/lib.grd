modul RingbufferSpscKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRingbufferSpscKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RingbufferSpscKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRingbufferSpscKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RingbufferSpscKilat {
    kembalikan RingbufferSpscKilat(
        identitas_modul = "RingbufferSpscKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RingbufferSpscKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RingbufferSpscKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ringbuffer_spsc_kilat(konteks: RingbufferSpscKilat, parameter: Teks): Hasil[RingbufferSpscKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ringbuffer_spsc_kilat tidak boleh hampa")
    }
    konst konteks_baru = RingbufferSpscKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

