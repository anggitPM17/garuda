modul PenyiaranPeristiwa

impor garuda::dasar
impor garuda::hasil

publik struktur PelangganTopik {
    id_pelanggan: Teks,
    topik: Teks,
    aktif: Kebenaran
}

publik struktur PenyiaranPeristiwa {
    daftar_pelanggan: Daftar[PelangganTopik],
    total_peristiwa_disiarkan: Bulat
}

publik fungsi inisialisasi(): PenyiaranPeristiwa {
    kembalikan PenyiaranPeristiwa(daftar_pelanggan = [], total_peristiwa_disiarkan = 0)
}

publik fungsi langganan(penyiar: PenyiaranPeristiwa, topik: Teks, id_pelanggan: Teks): PenyiaranPeristiwa {
    konst baru = PelangganTopik(id_pelanggan = id_pelanggan, topik = topik, aktif = benar)
    kembalikan PenyiaranPeristiwa(
        daftar_pelanggan = penyiar.daftar_pelanggan + [baru],
        total_peristiwa_disiarkan = penyiar.total_peristiwa_disiarkan
    )
}

publik fungsi berhenti_langganan(penyiar: PenyiaranPeristiwa, id_pelanggan: Teks): PenyiaranPeristiwa {
    variabel baru: Daftar[PelangganTopik] = []
    untuk p di penyiar.daftar_pelanggan {
        jika (p.id_pelanggan != id_pelanggan) {
            baru = baru + [p]
        }
    }
    kembalikan PenyiaranPeristiwa(daftar_pelanggan = baru, total_peristiwa_disiarkan = penyiar.total_peristiwa_disiarkan)
}

publik fungsi siarkan(penyiar: PenyiaranPeristiwa, topik: Teks, muatan: Teks): Pasangan[Bulat, PenyiaranPeristiwa] {
    variabel penerima = 0
    untuk p di penyiar.daftar_pelanggan {
        jika (p.topik == topik && p.aktif) {
            penerima = penerima + 1
        }
    }
    konst update = PenyiaranPeristiwa(
        daftar_pelanggan = penyiar.daftar_pelanggan,
        total_peristiwa_disiarkan = penyiar.total_peristiwa_disiarkan + 1
    )
    kembalikan Pasangan(penerima, update)
}