modul SsgIsrBuilderVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSsgIsrBuilderVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SsgIsrBuilderVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSsgIsrBuilderVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SsgIsrBuilderVektor {
    kembalikan SsgIsrBuilderVektor(
        identitas_modul = "SsgIsrBuilderVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SsgIsrBuilderVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SsgIsrBuilderVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ssg_isr_builder_vektor(konteks: SsgIsrBuilderVektor, parameter: Teks): Hasil[SsgIsrBuilderVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ssg_isr_builder_vektor tidak boleh hampa")
    }
    konst konteks_baru = SsgIsrBuilderVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

