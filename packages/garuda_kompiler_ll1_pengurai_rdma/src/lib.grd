modul Ll1PenguraiRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLl1PenguraiRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur Ll1PenguraiRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLl1PenguraiRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): Ll1PenguraiRdma {
    kembalikan Ll1PenguraiRdma(
        identitas_modul = "Ll1PenguraiRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: Ll1PenguraiRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: Ll1PenguraiRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ll1_pengurai_rdma(konteks: Ll1PenguraiRdma, parameter: Teks): Hasil[Ll1PenguraiRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ll1_pengurai_rdma tidak boleh hampa")
    }
    konst konteks_baru = Ll1PenguraiRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

