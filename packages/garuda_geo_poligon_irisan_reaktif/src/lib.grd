modul PoligonIrisanReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPoligonIrisanReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PoligonIrisanReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPoligonIrisanReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PoligonIrisanReaktif {
    kembalikan PoligonIrisanReaktif(
        identitas_modul = "PoligonIrisanReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PoligonIrisanReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PoligonIrisanReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_poligon_irisan_reaktif(konteks: PoligonIrisanReaktif, parameter: Teks): Hasil[PoligonIrisanReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_poligon_irisan_reaktif tidak boleh hampa")
    }
    konst konteks_baru = PoligonIrisanReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

