modul GameSpriteAnimasi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGameSpriteAnimasi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GameSpriteAnimasi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGameSpriteAnimasi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GameSpriteAnimasi {
    kembalikan GameSpriteAnimasi(
        identitas_modul = "GameSpriteAnimasi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GameSpriteAnimasi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GameSpriteAnimasi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_animasi_spritesheet(konteks: GameSpriteAnimasi, parameter: Teks): Hasil[GameSpriteAnimasi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_animasi_spritesheet tidak boleh hampa")
    }
    konst konteks_baru = GameSpriteAnimasi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

