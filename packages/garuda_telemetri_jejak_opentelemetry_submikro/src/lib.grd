modul JejakOpentelemetrySubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriJejakOpentelemetrySubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur JejakOpentelemetrySubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriJejakOpentelemetrySubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): JejakOpentelemetrySubmikro {
    kembalikan JejakOpentelemetrySubmikro(
        identitas_modul = "JejakOpentelemetrySubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: JejakOpentelemetrySubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: JejakOpentelemetrySubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_jejak_opentelemetry_submikro(konteks: JejakOpentelemetrySubmikro, parameter: Teks): Hasil[JejakOpentelemetrySubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_jejak_opentelemetry_submikro tidak boleh hampa")
    }
    konst konteks_baru = JejakOpentelemetrySubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

