modul RaytracingBvhTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRaytracingBvhTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RaytracingBvhTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRaytracingBvhTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RaytracingBvhTerdistribusi {
    kembalikan RaytracingBvhTerdistribusi(
        identitas_modul = "RaytracingBvhTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RaytracingBvhTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RaytracingBvhTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_raytracing_bvh_terdistribusi(konteks: RaytracingBvhTerdistribusi, parameter: Teks): Hasil[RaytracingBvhTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_raytracing_bvh_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = RaytracingBvhTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

