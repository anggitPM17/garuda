modul ArgumenCliVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriArgumenCliVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ArgumenCliVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriArgumenCliVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ArgumenCliVektor {
    kembalikan ArgumenCliVektor(
        identitas_modul = "ArgumenCliVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ArgumenCliVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ArgumenCliVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_argumen_cli_vektor(konteks: ArgumenCliVektor, parameter: Teks): Hasil[ArgumenCliVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_argumen_cli_vektor tidak boleh hampa")
    }
    konst konteks_baru = ArgumenCliVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

