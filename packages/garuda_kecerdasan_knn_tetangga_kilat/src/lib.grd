modul KnnTetanggaKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKnnTetanggaKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KnnTetanggaKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKnnTetanggaKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KnnTetanggaKilat {
    kembalikan KnnTetanggaKilat(
        identitas_modul = "KnnTetanggaKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KnnTetanggaKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KnnTetanggaKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_knn_tetangga_kilat(konteks: KnnTetanggaKilat, parameter: Teks): Hasil[KnnTetanggaKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_knn_tetangga_kilat tidak boleh hampa")
    }
    konst konteks_baru = KnnTetanggaKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

