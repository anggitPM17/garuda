modul LeakyBucketRingan

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLeakyBucketRingan {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur LeakyBucketRingan {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLeakyBucketRingan],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): LeakyBucketRingan {
    kembalikan LeakyBucketRingan(
        identitas_modul = "LeakyBucketRingan",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: LeakyBucketRingan): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: LeakyBucketRingan): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_leaky_bucket_ringan(konteks: LeakyBucketRingan, parameter: Teks): Hasil[LeakyBucketRingan, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_leaky_bucket_ringan tidak boleh hampa")
    }
    konst konteks_baru = LeakyBucketRingan(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

