modul ProbabilitasDistribusiSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriProbabilitasDistribusiSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ProbabilitasDistribusiSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriProbabilitasDistribusiSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ProbabilitasDistribusiSubmikro {
    kembalikan ProbabilitasDistribusiSubmikro(
        identitas_modul = "ProbabilitasDistribusiSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ProbabilitasDistribusiSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ProbabilitasDistribusiSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_probabilitas_distribusi_submikro(konteks: ProbabilitasDistribusiSubmikro, parameter: Teks): Hasil[ProbabilitasDistribusiSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_probabilitas_distribusi_submikro tidak boleh hampa")
    }
    konst konteks_baru = ProbabilitasDistribusiSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

