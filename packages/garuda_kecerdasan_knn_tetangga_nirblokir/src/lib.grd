modul KnnTetanggaNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKnnTetanggaNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KnnTetanggaNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKnnTetanggaNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KnnTetanggaNirblokir {
    kembalikan KnnTetanggaNirblokir(
        identitas_modul = "KnnTetanggaNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KnnTetanggaNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KnnTetanggaNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_knn_tetangga_nirblokir(konteks: KnnTetanggaNirblokir, parameter: Teks): Hasil[KnnTetanggaNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_knn_tetangga_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = KnnTetanggaNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

