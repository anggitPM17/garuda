modul Http3ServerSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHttp3ServerSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur Http3ServerSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHttp3ServerSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): Http3ServerSubmikro {
    kembalikan Http3ServerSubmikro(
        identitas_modul = "Http3ServerSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: Http3ServerSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: Http3ServerSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_http3_server_submikro(konteks: Http3ServerSubmikro, parameter: Teks): Hasil[Http3ServerSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_http3_server_submikro tidak boleh hampa")
    }
    konst konteks_baru = Http3ServerSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

