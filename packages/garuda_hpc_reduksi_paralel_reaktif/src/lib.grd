modul ReduksiParalelReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriReduksiParalelReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ReduksiParalelReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriReduksiParalelReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ReduksiParalelReaktif {
    kembalikan ReduksiParalelReaktif(
        identitas_modul = "ReduksiParalelReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ReduksiParalelReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ReduksiParalelReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_reduksi_paralel_reaktif(konteks: ReduksiParalelReaktif, parameter: Teks): Hasil[ReduksiParalelReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_reduksi_paralel_reaktif tidak boleh hampa")
    }
    konst konteks_baru = ReduksiParalelReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

