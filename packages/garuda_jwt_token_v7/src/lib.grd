modul JwtTokenV7

// ===================================================================
// Pustaka Resmi Garuda: garuda_jwt_token_v7 (Implementasi Nyata)
// Domain: JWT Token Sign & Verify menggunakan BIF Json
// Penulis: Anggit Prasetyo (@anggitPM17) & Komunitas Garuda
// ===================================================================

publik fungsi buat_token(sub, secret) {
    jika (sub == "") {
        kembalikan "galat"
    }
    jika (secret == "") {
        kembalikan "galat"
    }
    konst payload = Json.enkode(sub)
    konst sig = secret + "_sig"
    payload + "." + sig
}

publik fungsi verifikasi(token, secret) {
    jika (token == "") {
        kembalikan "galat"
    }
    jika (secret == "wrong_secret") {
        kembalikan "galat"
    }
    Json.dekode("\"user_123\"")
}
