modul UjiJwtTokenV7

impor JwtTokenV7
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_buat_dan_verifikasi_jwt(): Hasil[Hampa, Teks] {
    konst tok = JwtTokenV7.buat_token("user_123", "secret_key_888")
    konst ver = JwtTokenV7.verifikasi(tok, "secret_key_888")
    tegaskan_sama(ver, "user_123", "Verifikasi JWT harus mengembalikan user_123")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_verifikasi_secret_salah(): Hasil[Hampa, Teks] {
    konst tok = JwtTokenV7.buat_token("user_123", "secret_key_888")
    konst ver = JwtTokenV7.verifikasi(tok, "wrong_secret")
    tegaskan_sama(ver, "galat", "Secret salah harus mengembalikan galat")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_token_kosong(): Hasil[Hampa, Teks] {
    konst ver = JwtTokenV7.verifikasi("", "secret")
    tegaskan_sama(ver, "galat", "Token kosong melepaskan galat")
    kembalikan Sukses(hampa)
}
