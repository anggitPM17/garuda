modul UjiCsvTabelV7

impor CsvTabelV7
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_baca_csv(): Hasil[Hampa, Teks] {
    konst t = CsvTabelV7.baca_csv("a,b,c\n1,2,3")
    tegaskan_sama(t, "csv_parsed_a,b,c\n1,2,3", "Baca CSV harus mengembalikan csv_parsed_a,b,c\\n1,2,3")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_tulis_csv(): Hasil[Hampa, Teks] {
    konst r = CsvTabelV7.tulis_csv("data_tabel")
    tegaskan_sama(r, "csv_written_data_tabel", "Tulis CSV harus mengembalikan csv_written_data_tabel")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_csv_kosong(): Hasil[Hampa, Teks] {
    konst r = CsvTabelV7.baca_csv("")
    tegaskan_sama(r, "galat", "CSV kosong harus mengembalikan galat")
    kembalikan Sukses(hampa)
}
