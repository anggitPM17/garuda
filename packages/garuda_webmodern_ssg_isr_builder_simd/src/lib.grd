modul SsgIsrBuilderSimd

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSsgIsrBuilderSimd {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SsgIsrBuilderSimd {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSsgIsrBuilderSimd],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SsgIsrBuilderSimd {
    kembalikan SsgIsrBuilderSimd(
        identitas_modul = "SsgIsrBuilderSimd",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SsgIsrBuilderSimd): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SsgIsrBuilderSimd): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ssg_isr_builder_simd(konteks: SsgIsrBuilderSimd, parameter: Teks): Hasil[SsgIsrBuilderSimd, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ssg_isr_builder_simd tidak boleh hampa")
    }
    konst konteks_baru = SsgIsrBuilderSimd(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

