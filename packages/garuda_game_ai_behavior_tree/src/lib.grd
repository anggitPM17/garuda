modul GameAiBehaviorTree

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGameAiBehaviorTree {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GameAiBehaviorTree {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGameAiBehaviorTree],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GameAiBehaviorTree {
    kembalikan GameAiBehaviorTree(
        identitas_modul = "GameAiBehaviorTree",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GameAiBehaviorTree): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GameAiBehaviorTree): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi bangun_pohon_perilaku(konteks: GameAiBehaviorTree, parameter: Teks): Hasil[GameAiBehaviorTree, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi bangun_pohon_perilaku tidak boleh hampa")
    }
    konst konteks_baru = GameAiBehaviorTree(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

