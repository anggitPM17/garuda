modul DurasiParserVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriDurasiParserVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur DurasiParserVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriDurasiParserVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): DurasiParserVektor {
    kembalikan DurasiParserVektor(
        identitas_modul = "DurasiParserVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: DurasiParserVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: DurasiParserVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_durasi_parser_vektor(konteks: DurasiParserVektor, parameter: Teks): Hasil[DurasiParserVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_durasi_parser_vektor tidak boleh hampa")
    }
    konst konteks_baru = DurasiParserVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

