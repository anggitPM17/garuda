modul KnnTetanggaVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKnnTetanggaVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KnnTetanggaVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKnnTetanggaVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KnnTetanggaVektor {
    kembalikan KnnTetanggaVektor(
        identitas_modul = "KnnTetanggaVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KnnTetanggaVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KnnTetanggaVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_knn_tetangga_vektor(konteks: KnnTetanggaVektor, parameter: Teks): Hasil[KnnTetanggaVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_knn_tetangga_vektor tidak boleh hampa")
    }
    konst konteks_baru = KnnTetanggaVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

