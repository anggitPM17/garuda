modul TarArsipReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTarArsipReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TarArsipReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTarArsipReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TarArsipReaktif {
    kembalikan TarArsipReaktif(
        identitas_modul = "TarArsipReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TarArsipReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TarArsipReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tar_arsip_reaktif(konteks: TarArsipReaktif, parameter: Teks): Hasil[TarArsipReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tar_arsip_reaktif tidak boleh hampa")
    }
    konst konteks_baru = TarArsipReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

publik fungsi eksekusi_reaktif(konteks: TarArsipReaktif, parameter: Teks): Hasil[TarArsipReaktif, Teks] {
    jika (parameter.panjang() == 0) {
