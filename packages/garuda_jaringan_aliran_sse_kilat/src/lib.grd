modul AliranSseKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAliranSseKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AliranSseKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAliranSseKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AliranSseKilat {
    kembalikan AliranSseKilat(
        identitas_modul = "AliranSseKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AliranSseKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AliranSseKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_aliran_sse_kilat(konteks: AliranSseKilat, parameter: Teks): Hasil[AliranSseKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_aliran_sse_kilat tidak boleh hampa")
    }
    konst konteks_baru = AliranSseKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

