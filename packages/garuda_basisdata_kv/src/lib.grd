modul BasisDataKv

impor garuda::dasar
impor garuda::hasil

publik struktur CatatanWal {
    operasi: Teks,
    kunci: Teks,
    nilai: Teks,
    stempel_waktu: Bulat
}

publik struktur BasisDataKv {
    jalur_berkas: Teks,
    tabel_memori: Kamus[Teks, Teks],
    jurnal_wal: Daftar[CatatanWal],
    apakah_terkompaksi: Kebenaran
}

publik fungsi inisialisasi(): BasisDataKv {
    kembalikan buka_database("data/kv_default.wal")
}

publik fungsi buka_database(jalur: Teks): BasisDataKv {
    kembalikan BasisDataKv(
        jalur_berkas = jalur,
        tabel_memori = {},
        jurnal_wal = [],
        apakah_terkompaksi = benar
    )
}

publik fungsi simpan(db: BasisDataKv, kunci: Teks, nilai: Teks): Hasil[BasisDataKv, Teks] {
    jika (kunci.panjang() == 0) {
        kembalikan Gagal("Kunci database tidak boleh hampa")
    }
    konst catatan = CatatanWal(operasi = "SET", kunci = kunci, nilai = nilai, stempel_waktu = 1793898000)
    konst peta_baru = db.tabel_memori.tambah(kunci, nilai)
    konst wal_baru = db.jurnal_wal + [catatan]
    kembalikan Sukses(BasisDataKv(
        jalur_berkas = db.jalur_berkas,
        tabel_memori = peta_baru,
        jurnal_wal = wal_baru,
        apakah_terkompaksi = salah
    ))
}

publik fungsi ambil(db: BasisDataKv, kunci: Teks): Hasil[Teks, Teks] {
    jika (db.tabel_memori.memiliki_kunci(kunci)) {
        kembalikan Sukses(db.tabel_memori.ambil(kunci))
    }
    kembalikan Gagal("Kunci '" + kunci + "' tidak ditemukan dalam basisdata")
}

publik fungsi ada(db: BasisDataKv, kunci: Teks): Kebenaran {
    kembalikan db.tabel_memori.memiliki_kunci(kunci)
}

publik fungsi hapus(db: BasisDataKv, kunci: Teks): Hasil[BasisDataKv, Teks] {
    jika (!db.tabel_memori.memiliki_kunci(kunci)) {
        kembalikan Gagal("Kunci '" + kunci + "' tidak ada untuk dihapus")
    }
    konst catatan = CatatanWal(operasi = "DEL", kunci = kunci, nilai = "", stempel_waktu = 1793898000)
    konst peta_baru = db.tabel_memori.hapus_kunci(kunci)
    konst wal_baru = db.jurnal_wal + [catatan]
    kembalikan Sukses(BasisDataKv(
        jalur_berkas = db.jalur_berkas,
        tabel_memori = peta_baru,
        jurnal_wal = wal_baru,
        apakah_terkompaksi = salah
    ))
}

publik fungsi daftar_kunci(db: BasisDataKv): Daftar[Teks] {
    kembalikan db.tabel_memori.kunci_kunci()
}

publik fungsi pulihkan_dari_wal(jalur: Teks, rekaman_wal: Daftar[CatatanWal]): BasisDataKv {
    variabel db = buka_database(jalur)
    untuk catatan di rekaman_wal {
        jika (catatan.operasi == "SET") {
            db = BasisDataKv(
                jalur_berkas = db.jalur_berkas,
                tabel_memori = db.tabel_memori.tambah(catatan.kunci, catatan.nilai),
                jurnal_wal = db.jurnal_wal + [catatan],
                apakah_terkompaksi = db.apakah_terkompaksi
            )
        } lainnya jika (catatan.operasi == "DEL") {
            db = BasisDataKv(
                jalur_berkas = db.jalur_berkas,
                tabel_memori = db.tabel_memori.hapus_kunci(catatan.kunci),
                jurnal_wal = db.jurnal_wal + [catatan],
                apakah_terkompaksi = db.apakah_terkompaksi
            )
        }
    }
    kembalikan db
}

publik fungsi kompaksi(db: BasisDataKv): BasisDataKv {
    variabel wal_bersih: Daftar[CatatanWal] = []
    untuk kunci di db.tabel_memori.kunci_kunci() {
        konst val = db.tabel_memori.ambil(kunci)
        wal_bersih = wal_bersih + [CatatanWal(operasi = "SET", kunci = kunci, nilai = val, stempel_waktu = 1793898000)]
    }
    kembalikan BasisDataKv(
        jalur_berkas = db.jalur_berkas,
        tabel_memori = db.tabel_memori,
        jurnal_wal = wal_bersih,
        apakah_terkompaksi = benar
    )
}