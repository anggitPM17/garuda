modul TransformerPerhatianTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTransformerPerhatianTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TransformerPerhatianTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTransformerPerhatianTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TransformerPerhatianTerdistribusi {
    kembalikan TransformerPerhatianTerdistribusi(
        identitas_modul = "TransformerPerhatianTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TransformerPerhatianTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TransformerPerhatianTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_transformer_perhatian_terdistribusi(konteks: TransformerPerhatianTerdistribusi, parameter: Teks): Hasil[TransformerPerhatianTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_transformer_perhatian_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = TransformerPerhatianTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

