modul UjiRegexPolaV8

impor RegexPolaV8
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_kompilasi_pola(): Hasil[Hampa, Teks] {
    konst p = RegexPolaV8.kompilasi_pola("^[a-z]+$")
    tegaskan_sama(p, "pola_^[a-z]+$", "Kompilasi pola harus mengembalikan pola_^[a-z]+$")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_cocokkan_teks_valid(): Hasil[Hampa, Teks] {
    konst m = RegexPolaV8.cocokkan_teks("halo")
    tegaskan_sama(m, benar, "Cocokkan teks valid harus mengembalikan benar")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_cocokkan_teks_kosong(): Hasil[Hampa, Teks] {
    konst m = RegexPolaV8.cocokkan_teks("")
    tegaskan_sama(m, salah, "Cocokkan teks kosong harus mengembalikan salah")
    kembalikan Sukses(hampa)
}
