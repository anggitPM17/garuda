modul PenjadwalInferensiReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPenjadwalInferensiReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PenjadwalInferensiReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPenjadwalInferensiReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PenjadwalInferensiReaktif {
    kembalikan PenjadwalInferensiReaktif(
        identitas_modul = "PenjadwalInferensiReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PenjadwalInferensiReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PenjadwalInferensiReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_penjadwal_inferensi_reaktif(konteks: PenjadwalInferensiReaktif, parameter: Teks): Hasil[PenjadwalInferensiReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_penjadwal_inferensi_reaktif tidak boleh hampa")
    }
    konst konteks_baru = PenjadwalInferensiReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

