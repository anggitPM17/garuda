modul UjiIdentitasUuidV8

impor IdentitasUuidV8
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_buat_uuid_v4(): Hasil[Hampa, Teks] {
    konst id = IdentitasUuidV8.buat_uuid_v4("seed123")
    tegaskan_sama(id, "uuid4_seed123", "Buat UUID v4 harus mengembalikan format uuid4_seed123")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_validasi_uuid_valid(): Hasil[Hampa, Teks] {
    konst val = IdentitasUuidV8.validasi_uuid("uuid4_seed123")
    tegaskan_sama(val, benar, "Validasi UUID valid harus mengembalikan benar")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_validasi_uuid_invalid(): Hasil[Hampa, Teks] {
    konst val = IdentitasUuidV8.validasi_uuid("invalid_uuid")
    tegaskan_sama(val, salah, "Validasi UUID invalid harus mengembalikan salah")
    kembalikan Sukses(hampa)
}
