modul RingbufferSpscVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRingbufferSpscVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RingbufferSpscVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRingbufferSpscVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RingbufferSpscVektor {
    kembalikan RingbufferSpscVektor(
        identitas_modul = "RingbufferSpscVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RingbufferSpscVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RingbufferSpscVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ringbuffer_spsc_vektor(konteks: RingbufferSpscVektor, parameter: Teks): Hasil[RingbufferSpscVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ringbuffer_spsc_vektor tidak boleh hampa")
    }
    konst konteks_baru = RingbufferSpscVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

