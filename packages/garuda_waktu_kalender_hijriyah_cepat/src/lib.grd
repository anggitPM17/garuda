modul KalenderHijriyahCepat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKalenderHijriyahCepat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KalenderHijriyahCepat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKalenderHijriyahCepat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KalenderHijriyahCepat {
    kembalikan KalenderHijriyahCepat(
        identitas_modul = "KalenderHijriyahCepat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KalenderHijriyahCepat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KalenderHijriyahCepat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_kalender_hijriyah_cepat(konteks: KalenderHijriyahCepat, parameter: Teks): Hasil[KalenderHijriyahCepat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_kalender_hijriyah_cepat tidak boleh hampa")
    }
    konst konteks_baru = KalenderHijriyahCepat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

