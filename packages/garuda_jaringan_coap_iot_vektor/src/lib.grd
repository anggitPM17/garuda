modul CoapIotVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriCoapIotVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur CoapIotVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriCoapIotVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): CoapIotVektor {
    kembalikan CoapIotVektor(
        identitas_modul = "CoapIotVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: CoapIotVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: CoapIotVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_coap_iot_vektor(konteks: CoapIotVektor, parameter: Teks): Hasil[CoapIotVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_coap_iot_vektor tidak boleh hampa")
    }
    konst konteks_baru = CoapIotVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

