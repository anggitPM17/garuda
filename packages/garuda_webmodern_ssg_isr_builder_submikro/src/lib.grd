modul SsgIsrBuilderSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSsgIsrBuilderSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SsgIsrBuilderSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSsgIsrBuilderSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SsgIsrBuilderSubmikro {
    kembalikan SsgIsrBuilderSubmikro(
        identitas_modul = "SsgIsrBuilderSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SsgIsrBuilderSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SsgIsrBuilderSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ssg_isr_builder_submikro(konteks: SsgIsrBuilderSubmikro, parameter: Teks): Hasil[SsgIsrBuilderSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ssg_isr_builder_submikro tidak boleh hampa")
    }
    konst konteks_baru = SsgIsrBuilderSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

