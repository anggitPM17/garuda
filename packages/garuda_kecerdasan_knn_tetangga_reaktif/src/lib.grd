modul KnnTetanggaReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKnnTetanggaReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KnnTetanggaReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKnnTetanggaReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KnnTetanggaReaktif {
    kembalikan KnnTetanggaReaktif(
        identitas_modul = "KnnTetanggaReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KnnTetanggaReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KnnTetanggaReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_knn_tetangga_reaktif(konteks: KnnTetanggaReaktif, parameter: Teks): Hasil[KnnTetanggaReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_knn_tetangga_reaktif tidak boleh hampa")
    }
    konst konteks_baru = KnnTetanggaReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

