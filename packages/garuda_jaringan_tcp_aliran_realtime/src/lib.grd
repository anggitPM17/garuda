modul TcpAliranRealtime

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTcpAliranRealtime {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TcpAliranRealtime {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTcpAliranRealtime],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TcpAliranRealtime {
    kembalikan TcpAliranRealtime(
        identitas_modul = "TcpAliranRealtime",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TcpAliranRealtime): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TcpAliranRealtime): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tcp_aliran_realtime(konteks: TcpAliranRealtime, parameter: Teks): Hasil[TcpAliranRealtime, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tcp_aliran_realtime tidak boleh hampa")
    }
    konst konteks_baru = TcpAliranRealtime(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

