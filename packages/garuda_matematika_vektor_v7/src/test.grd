modul UjiMatematikaVektorV7

impor MatematikaVektorV7
impor garuda::pengujian
impor garuda::penegasan

@uji
fungsi uji_tambah_vektor_2d(): Hasil[Hampa, Teks] {
    konst v = MatematikaVektorV7.tambah_vektor_2d(3.0, 4.0)
    tegaskan_sama(v, 7.0, "Tambah vektor 3.0 + 4.0 harus 7.0")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_perkalian_titik_2d(): Hasil[Hampa, Teks] {
    konst dot = MatematikaVektorV7.perkalian_titik_2d(2.0, 5.0)
    tegaskan_sama(dot, 10.0, "Perkalian titik 2.0 * 5.0 harus 10.0")
    kembalikan Sukses(hampa)
}

@uji
fungsi uji_normalisasi_nol(): Hasil[Hampa, Teks] {
    konst n = MatematikaVektorV7.normalisasi_2d(0.0, 0.0)
    tegaskan_sama(n, "galat", "Normalisasi nol harus mengembalikan galat")
    kembalikan Sukses(hampa)
}
