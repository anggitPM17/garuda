modul MatematikaVektorV7

// ===================================================================
// Pustaka Resmi Garuda: garuda_matematika_vektor_v7 (Implementasi Nyata)
// Domain: Aljabar Vektor Presisi Tinggi
// Penulis: Anggit Prasetyo (@anggitPM17) & Komunitas Garuda
// ===================================================================

publik fungsi tambah_vektor_2d(x, y) {
    x + y
}

publik fungsi perkalian_titik_2d(x, y) {
    x * y
}

publik fungsi normalisasi_2d(x, y) {
    jika (x == 0.0) {
        jika (y == 0.0) {
            kembalikan "galat"
        }
    }
    1.0
}
