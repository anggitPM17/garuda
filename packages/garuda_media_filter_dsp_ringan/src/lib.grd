modul FilterDspRingan

impor garuda::dasar
impor garuda::hasil

publik struktur EntriFilterDspRingan {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur FilterDspRingan {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriFilterDspRingan],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): FilterDspRingan {
    kembalikan FilterDspRingan(
        identitas_modul = "FilterDspRingan",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: FilterDspRingan): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: FilterDspRingan): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_filter_dsp_ringan(konteks: FilterDspRingan, parameter: Teks): Hasil[FilterDspRingan, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_filter_dsp_ringan tidak boleh hampa")
    }
    konst konteks_baru = FilterDspRingan(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

