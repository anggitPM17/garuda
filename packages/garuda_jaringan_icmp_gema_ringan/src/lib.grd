modul IcmpGemaRingan

impor garuda::dasar
impor garuda::hasil

publik struktur EntriIcmpGemaRingan {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur IcmpGemaRingan {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriIcmpGemaRingan],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): IcmpGemaRingan {
    kembalikan IcmpGemaRingan(
        identitas_modul = "IcmpGemaRingan",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: IcmpGemaRingan): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: IcmpGemaRingan): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_icmp_gema_ringan(konteks: IcmpGemaRingan, parameter: Teks): Hasil[IcmpGemaRingan, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_icmp_gema_ringan tidak boleh hampa")
    }
    konst konteks_baru = IcmpGemaRingan(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

