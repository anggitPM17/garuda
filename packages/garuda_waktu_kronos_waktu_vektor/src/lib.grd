modul KronosWaktuVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKronosWaktuVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KronosWaktuVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKronosWaktuVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KronosWaktuVektor {
    kembalikan KronosWaktuVektor(
        identitas_modul = "KronosWaktuVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KronosWaktuVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KronosWaktuVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_kronos_waktu_vektor(konteks: KronosWaktuVektor, parameter: Teks): Hasil[KronosWaktuVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_kronos_waktu_vektor tidak boleh hampa")
    }
    konst konteks_baru = KronosWaktuVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

