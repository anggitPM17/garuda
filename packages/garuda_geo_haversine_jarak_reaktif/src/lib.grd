modul HaversineJarakReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHaversineJarakReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HaversineJarakReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHaversineJarakReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HaversineJarakReaktif {
    kembalikan HaversineJarakReaktif(
        identitas_modul = "HaversineJarakReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HaversineJarakReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HaversineJarakReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_haversine_jarak_reaktif(konteks: HaversineJarakReaktif, parameter: Teks): Hasil[HaversineJarakReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_haversine_jarak_reaktif tidak boleh hampa")
    }
    konst konteks_baru = HaversineJarakReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

