modul RaytracingBvhSimd

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRaytracingBvhSimd {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RaytracingBvhSimd {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRaytracingBvhSimd],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RaytracingBvhSimd {
    kembalikan RaytracingBvhSimd(
        identitas_modul = "RaytracingBvhSimd",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RaytracingBvhSimd): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RaytracingBvhSimd): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_raytracing_bvh_simd(konteks: RaytracingBvhSimd, parameter: Teks): Hasil[RaytracingBvhSimd, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_raytracing_bvh_simd tidak boleh hampa")
    }
    konst konteks_baru = RaytracingBvhSimd(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

