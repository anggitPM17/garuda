modul SsgIsrBuilderKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSsgIsrBuilderKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SsgIsrBuilderKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSsgIsrBuilderKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SsgIsrBuilderKilat {
    kembalikan SsgIsrBuilderKilat(
        identitas_modul = "SsgIsrBuilderKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SsgIsrBuilderKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SsgIsrBuilderKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ssg_isr_builder_kilat(konteks: SsgIsrBuilderKilat, parameter: Teks): Hasil[SsgIsrBuilderKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ssg_isr_builder_kilat tidak boleh hampa")
    }
    konst konteks_baru = SsgIsrBuilderKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

