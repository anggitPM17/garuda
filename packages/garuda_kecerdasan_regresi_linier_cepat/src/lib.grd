modul RegresiLinierCepat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRegresiLinierCepat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RegresiLinierCepat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRegresiLinierCepat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RegresiLinierCepat {
    kembalikan RegresiLinierCepat(
        identitas_modul = "RegresiLinierCepat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RegresiLinierCepat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RegresiLinierCepat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_regresi_linier_cepat(konteks: RegresiLinierCepat, parameter: Teks): Hasil[RegresiLinierCepat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_regresi_linier_cepat tidak boleh hampa")
    }
    konst konteks_baru = RegresiLinierCepat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

