modul Ll1PenguraiKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriLl1PenguraiKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur Ll1PenguraiKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriLl1PenguraiKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): Ll1PenguraiKilat {
    kembalikan Ll1PenguraiKilat(
        identitas_modul = "Ll1PenguraiKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: Ll1PenguraiKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: Ll1PenguraiKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ll1_pengurai_kilat(konteks: Ll1PenguraiKilat, parameter: Teks): Hasil[Ll1PenguraiKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ll1_pengurai_kilat tidak boleh hampa")
    }
    konst konteks_baru = Ll1PenguraiKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

