modul DurasiParserReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriDurasiParserReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur DurasiParserReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriDurasiParserReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): DurasiParserReaktif {
    kembalikan DurasiParserReaktif(
        identitas_modul = "DurasiParserReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: DurasiParserReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: DurasiParserReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_durasi_parser_reaktif(konteks: DurasiParserReaktif, parameter: Teks): Hasil[DurasiParserReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_durasi_parser_reaktif tidak boleh hampa")
    }
    konst konteks_baru = DurasiParserReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

