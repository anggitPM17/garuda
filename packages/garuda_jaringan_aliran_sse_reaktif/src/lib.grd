modul AliranSseReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAliranSseReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AliranSseReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAliranSseReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AliranSseReaktif {
    kembalikan AliranSseReaktif(
        identitas_modul = "AliranSseReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AliranSseReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AliranSseReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_aliran_sse_reaktif(konteks: AliranSseReaktif, parameter: Teks): Hasil[AliranSseReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_aliran_sse_reaktif tidak boleh hampa")
    }
    konst konteks_baru = AliranSseReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

