modul PropertiUjiAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPropertiUjiAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PropertiUjiAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPropertiUjiAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PropertiUjiAman {
    kembalikan PropertiUjiAman(
        identitas_modul = "PropertiUjiAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PropertiUjiAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PropertiUjiAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_properti_uji_aman(konteks: PropertiUjiAman, parameter: Teks): Hasil[PropertiUjiAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_properti_uji_aman tidak boleh hampa")
    }
    konst konteks_baru = PropertiUjiAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

