modul NaiveBayesReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriNaiveBayesReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur NaiveBayesReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriNaiveBayesReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): NaiveBayesReaktif {
    kembalikan NaiveBayesReaktif(
        identitas_modul = "NaiveBayesReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: NaiveBayesReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: NaiveBayesReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_naive_bayes_reaktif(konteks: NaiveBayesReaktif, parameter: Teks): Hasil[NaiveBayesReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_naive_bayes_reaktif tidak boleh hampa")
    }
    konst konteks_baru = NaiveBayesReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

