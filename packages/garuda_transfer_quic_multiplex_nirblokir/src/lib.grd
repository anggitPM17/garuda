modul QuicMultiplexNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriQuicMultiplexNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur QuicMultiplexNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriQuicMultiplexNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): QuicMultiplexNirblokir {
    kembalikan QuicMultiplexNirblokir(
        identitas_modul = "QuicMultiplexNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: QuicMultiplexNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: QuicMultiplexNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_quic_multiplex_nirblokir(konteks: QuicMultiplexNirblokir, parameter: Teks): Hasil[QuicMultiplexNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_quic_multiplex_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = QuicMultiplexNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

