modul TarArsipSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTarArsipSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TarArsipSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTarArsipSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TarArsipSubmikro {
    kembalikan TarArsipSubmikro(
        identitas_modul = "TarArsipSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TarArsipSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TarArsipSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tar_arsip_submikro(konteks: TarArsipSubmikro, parameter: Teks): Hasil[TarArsipSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tar_arsip_submikro tidak boleh hampa")
    }
    konst konteks_baru = TarArsipSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

