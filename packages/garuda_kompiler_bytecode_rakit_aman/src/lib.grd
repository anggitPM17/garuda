modul BytecodeRakitAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriBytecodeRakitAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur BytecodeRakitAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriBytecodeRakitAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): BytecodeRakitAman {
    kembalikan BytecodeRakitAman(
        identitas_modul = "BytecodeRakitAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: BytecodeRakitAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: BytecodeRakitAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_bytecode_rakit_aman(konteks: BytecodeRakitAman, parameter: Teks): Hasil[BytecodeRakitAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_bytecode_rakit_aman tidak boleh hampa")
    }
    konst konteks_baru = BytecodeRakitAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

