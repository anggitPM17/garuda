modul MemoriNumaRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMemoriNumaRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MemoriNumaRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMemoriNumaRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MemoriNumaRdma {
    kembalikan MemoriNumaRdma(
        identitas_modul = "MemoriNumaRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MemoriNumaRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MemoriNumaRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_memori_numa_rdma(konteks: MemoriNumaRdma, parameter: Teks): Hasil[MemoriNumaRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_memori_numa_rdma tidak boleh hampa")
    }
    konst konteks_baru = MemoriNumaRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

