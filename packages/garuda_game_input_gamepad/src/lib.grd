modul GameInputGamepad

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGameInputGamepad {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GameInputGamepad {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGameInputGamepad],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GameInputGamepad {
    kembalikan GameInputGamepad(
        identitas_modul = "GameInputGamepad",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GameInputGamepad): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GameInputGamepad): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi baca_joystick_virtual(konteks: GameInputGamepad, parameter: Teks): Hasil[GameInputGamepad, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi baca_joystick_virtual tidak boleh hampa")
    }
    konst konteks_baru = GameInputGamepad(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

