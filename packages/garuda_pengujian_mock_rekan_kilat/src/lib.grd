modul MockRekanKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMockRekanKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MockRekanKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMockRekanKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MockRekanKilat {
    kembalikan MockRekanKilat(
        identitas_modul = "MockRekanKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MockRekanKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MockRekanKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mock_rekan_kilat(konteks: MockRekanKilat, parameter: Teks): Hasil[MockRekanKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mock_rekan_kilat tidak boleh hampa")
    }
    konst konteks_baru = MockRekanKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

