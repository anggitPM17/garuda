modul KalenderHijriyahNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKalenderHijriyahNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KalenderHijriyahNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKalenderHijriyahNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KalenderHijriyahNirblokir {
    kembalikan KalenderHijriyahNirblokir(
        identitas_modul = "KalenderHijriyahNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KalenderHijriyahNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KalenderHijriyahNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_kalender_hijriyah_nirblokir(konteks: KalenderHijriyahNirblokir, parameter: Teks): Hasil[KalenderHijriyahNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_kalender_hijriyah_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = KalenderHijriyahNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

