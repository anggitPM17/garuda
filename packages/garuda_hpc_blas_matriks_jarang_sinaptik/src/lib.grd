modul BlasMatriksJarangSinaptik

impor garuda::dasar
impor garuda::hasil

publik struktur EntriBlasMatriksJarangSinaptik {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur BlasMatriksJarangSinaptik {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriBlasMatriksJarangSinaptik],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): BlasMatriksJarangSinaptik {
    kembalikan BlasMatriksJarangSinaptik(
        identitas_modul = "BlasMatriksJarangSinaptik",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: BlasMatriksJarangSinaptik): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: BlasMatriksJarangSinaptik): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_blas_matriks_jarang_sinaptik(konteks: BlasMatriksJarangSinaptik, parameter: Teks): Hasil[BlasMatriksJarangSinaptik, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_blas_matriks_jarang_sinaptik tidak boleh hampa")
    }
    konst konteks_baru = BlasMatriksJarangSinaptik(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

