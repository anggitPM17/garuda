modul StatistikDeskriptifReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriStatistikDeskriptifReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur StatistikDeskriptifReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriStatistikDeskriptifReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): StatistikDeskriptifReaktif {
    kembalikan StatistikDeskriptifReaktif(
        identitas_modul = "StatistikDeskriptifReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: StatistikDeskriptifReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: StatistikDeskriptifReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_statistik_deskriptif_reaktif(konteks: StatistikDeskriptifReaktif, parameter: Teks): Hasil[StatistikDeskriptifReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_statistik_deskriptif_reaktif tidak boleh hampa")
    }
    konst konteks_baru = StatistikDeskriptifReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

publik fungsi eksekusi_reaktif(konteks: StatistikDeskriptifReaktif, parameter: Teks): Hasil[StatistikDeskriptifReaktif, Teks] {
    jika (parameter.panjang() == 0) {
