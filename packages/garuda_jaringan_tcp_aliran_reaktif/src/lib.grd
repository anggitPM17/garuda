modul TcpAliranReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriTcpAliranReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur TcpAliranReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriTcpAliranReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): TcpAliranReaktif {
    kembalikan TcpAliranReaktif(
        identitas_modul = "TcpAliranReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: TcpAliranReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: TcpAliranReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_tcp_aliran_reaktif(konteks: TcpAliranReaktif, parameter: Teks): Hasil[TcpAliranReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_tcp_aliran_reaktif tidak boleh hampa")
    }
    konst konteks_baru = TcpAliranReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

