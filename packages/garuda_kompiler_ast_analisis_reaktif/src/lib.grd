modul AstAnalisisReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAstAnalisisReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AstAnalisisReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAstAnalisisReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AstAnalisisReaktif {
    kembalikan AstAnalisisReaktif(
        identitas_modul = "AstAnalisisReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AstAnalisisReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AstAnalisisReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ast_analisis_reaktif(konteks: AstAnalisisReaktif, parameter: Teks): Hasil[AstAnalisisReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ast_analisis_reaktif tidak boleh hampa")
    }
    konst konteks_baru = AstAnalisisReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

