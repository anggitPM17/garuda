modul PropertiUjiRealtime

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPropertiUjiRealtime {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PropertiUjiRealtime {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPropertiUjiRealtime],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PropertiUjiRealtime {
    kembalikan PropertiUjiRealtime(
        identitas_modul = "PropertiUjiRealtime",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PropertiUjiRealtime): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PropertiUjiRealtime): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_properti_uji_realtime(konteks: PropertiUjiRealtime, parameter: Teks): Hasil[PropertiUjiRealtime, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_properti_uji_realtime tidak boleh hampa")
    }
    konst konteks_baru = PropertiUjiRealtime(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

