modul PropertiUjiVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPropertiUjiVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PropertiUjiVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPropertiUjiVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PropertiUjiVektor {
    kembalikan PropertiUjiVektor(
        identitas_modul = "PropertiUjiVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PropertiUjiVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PropertiUjiVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_properti_uji_vektor(konteks: PropertiUjiVektor, parameter: Teks): Hasil[PropertiUjiVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_properti_uji_vektor tidak boleh hampa")
    }
    konst konteks_baru = PropertiUjiVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

