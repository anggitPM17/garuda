modul SpikeTrainPenguraiNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriSpikeTrainPenguraiNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur SpikeTrainPenguraiNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriSpikeTrainPenguraiNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): SpikeTrainPenguraiNirblokir {
    kembalikan SpikeTrainPenguraiNirblokir(
        identitas_modul = "SpikeTrainPenguraiNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: SpikeTrainPenguraiNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: SpikeTrainPenguraiNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_spike_train_pengurai_nirblokir(konteks: SpikeTrainPenguraiNirblokir, parameter: Teks): Hasil[SpikeTrainPenguraiNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_spike_train_pengurai_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = SpikeTrainPenguraiNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

