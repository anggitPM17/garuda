modul GameTilemap2d

impor garuda::dasar
impor garuda::hasil

publik struktur EntriGameTilemap2d {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur GameTilemap2d {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriGameTilemap2d],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): GameTilemap2d {
    kembalikan GameTilemap2d(
        identitas_modul = "GameTilemap2d",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: GameTilemap2d): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: GameTilemap2d): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi muat_peta_tiled(konteks: GameTilemap2d, parameter: Teks): Hasil[GameTilemap2d, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi muat_peta_tiled tidak boleh hampa")
    }
    konst konteks_baru = GameTilemap2d(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

