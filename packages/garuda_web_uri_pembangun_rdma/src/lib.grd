modul UriPembangunRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriUriPembangunRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur UriPembangunRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriUriPembangunRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): UriPembangunRdma {
    kembalikan UriPembangunRdma(
        identitas_modul = "UriPembangunRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: UriPembangunRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: UriPembangunRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_uri_pembangun_rdma(konteks: UriPembangunRdma, parameter: Teks): Hasil[UriPembangunRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_uri_pembangun_rdma tidak boleh hampa")
    }
    konst konteks_baru = UriPembangunRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

