modul CsvTabel

impor garuda::dasar
impor garuda::hasil

publik struktur TabelCsv {
    header: Daftar[Teks],
    baris_data: Daftar[Daftar[Teks]],
    jumlah_baris: Bulat
}

publik fungsi inisialisasi(): TabelCsv {
    kembalikan TabelCsv(
        header = ["id", "nama", "status"],
        baris_data = [],
        jumlah_baris = 0
    )
}

publik fungsi urai_csv(konten: Teks, gunakan_header: Kebenaran): Hasil[TabelCsv, Teks] {
    jika (konten.panjang() == 0) {
        kembalikan Sukses(TabelCsv(header = [], baris_data = [], jumlah_baris = 0))
    }
    konst baris = konten.pisah("\n")
    jika (baris.panjang() == 0) {
        kembalikan Sukses(TabelCsv(header = [], baris_data = [], jumlah_baris = 0))
    }

    variabel hdr: Daftar[Teks] = []
    variabel data: Daftar[Daftar[Teks]] = []

    variabel indeks_mulai = 0
    jika (gunakan_header) {
        hdr = baris.ambil(0).pisah(",")
        indeks_mulai = 1
    }

    untuk i di indeks_mulai..(baris.panjang() - 1) {
        konst b = baris.ambil(i).pangkas()
        jika (b.panjang() > 0) {
            data = data + [b.pisah(",")]
        }
    }

    kembalikan Sukses(TabelCsv(
        header = hdr,
        baris_data = data,
        jumlah_baris = data.panjang()
    ))
}

publik fungsi tulis_csv(tabel: TabelCsv): Teks {
    variabel sb = tabel.header.gabung(",") + "\n"
    untuk baris di tabel.baris_data {
        sb = sb + baris.gabung(",") + "\n"
    }
    kembalikan sb
}