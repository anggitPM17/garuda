modul AstAnalisisCepat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriAstAnalisisCepat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur AstAnalisisCepat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriAstAnalisisCepat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): AstAnalisisCepat {
    kembalikan AstAnalisisCepat(
        identitas_modul = "AstAnalisisCepat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: AstAnalisisCepat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: AstAnalisisCepat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ast_analisis_cepat(konteks: AstAnalisisCepat, parameter: Teks): Hasil[AstAnalisisCepat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ast_analisis_cepat tidak boleh hampa")
    }
    konst konteks_baru = AstAnalisisCepat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

