modul PemantauDirektoriSubmikro

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPemantauDirektoriSubmikro {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PemantauDirektoriSubmikro {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPemantauDirektoriSubmikro],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PemantauDirektoriSubmikro {
    kembalikan PemantauDirektoriSubmikro(
        identitas_modul = "PemantauDirektoriSubmikro",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PemantauDirektoriSubmikro): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PemantauDirektoriSubmikro): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_pemantau_direktori_submikro(konteks: PemantauDirektoriSubmikro, parameter: Teks): Hasil[PemantauDirektoriSubmikro, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_pemantau_direktori_submikro tidak boleh hampa")
    }
    konst konteks_baru = PemantauDirektoriSubmikro(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

