modul ReduksiParalelRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriReduksiParalelRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ReduksiParalelRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriReduksiParalelRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ReduksiParalelRdma {
    kembalikan ReduksiParalelRdma(
        identitas_modul = "ReduksiParalelRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ReduksiParalelRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ReduksiParalelRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_reduksi_paralel_rdma(konteks: ReduksiParalelRdma, parameter: Teks): Hasil[ReduksiParalelRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_reduksi_paralel_rdma tidak boleh hampa")
    }
    konst konteks_baru = ReduksiParalelRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

