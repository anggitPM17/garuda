modul StatistikDeskriptifAman

impor garuda::dasar
impor garuda::hasil

publik struktur EntriStatistikDeskriptifAman {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur StatistikDeskriptifAman {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriStatistikDeskriptifAman],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): StatistikDeskriptifAman {
    kembalikan StatistikDeskriptifAman(
        identitas_modul = "StatistikDeskriptifAman",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: StatistikDeskriptifAman): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: StatistikDeskriptifAman): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_statistik_deskriptif_aman(konteks: StatistikDeskriptifAman, parameter: Teks): Hasil[StatistikDeskriptifAman, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_statistik_deskriptif_aman tidak boleh hampa")
    }
    konst konteks_baru = StatistikDeskriptifAman(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

