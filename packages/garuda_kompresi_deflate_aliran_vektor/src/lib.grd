modul DeflateAliranVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriDeflateAliranVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur DeflateAliranVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriDeflateAliranVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): DeflateAliranVektor {
    kembalikan DeflateAliranVektor(
        identitas_modul = "DeflateAliranVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: DeflateAliranVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: DeflateAliranVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_deflate_aliran_vektor(konteks: DeflateAliranVektor, parameter: Teks): Hasil[DeflateAliranVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_deflate_aliran_vektor tidak boleh hampa")
    }
    konst konteks_baru = DeflateAliranVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

