modul MidiSintesisRingan

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMidiSintesisRingan {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MidiSintesisRingan {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMidiSintesisRingan],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MidiSintesisRingan {
    kembalikan MidiSintesisRingan(
        identitas_modul = "MidiSintesisRingan",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MidiSintesisRingan): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MidiSintesisRingan): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_midi_sintesis_ringan(konteks: MidiSintesisRingan, parameter: Teks): Hasil[MidiSintesisRingan, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_midi_sintesis_ringan tidak boleh hampa")
    }
    konst konteks_baru = MidiSintesisRingan(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

