modul RingbufferSpscTerdistribusi

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRingbufferSpscTerdistribusi {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RingbufferSpscTerdistribusi {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRingbufferSpscTerdistribusi],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RingbufferSpscTerdistribusi {
    kembalikan RingbufferSpscTerdistribusi(
        identitas_modul = "RingbufferSpscTerdistribusi",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RingbufferSpscTerdistribusi): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RingbufferSpscTerdistribusi): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ringbuffer_spsc_terdistribusi(konteks: RingbufferSpscTerdistribusi, parameter: Teks): Hasil[RingbufferSpscTerdistribusi, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ringbuffer_spsc_terdistribusi tidak boleh hampa")
    }
    konst konteks_baru = RingbufferSpscTerdistribusi(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

