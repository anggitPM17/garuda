modul WebauthnPasskeysReaktif

impor garuda::dasar
impor garuda::hasil

publik struktur EntriWebauthnPasskeysReaktif {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur WebauthnPasskeysReaktif {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriWebauthnPasskeysReaktif],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): WebauthnPasskeysReaktif {
    kembalikan WebauthnPasskeysReaktif(
        identitas_modul = "WebauthnPasskeysReaktif",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: WebauthnPasskeysReaktif): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: WebauthnPasskeysReaktif): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_webauthn_passkeys_reaktif(konteks: WebauthnPasskeysReaktif, parameter: Teks): Hasil[WebauthnPasskeysReaktif, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_webauthn_passkeys_reaktif tidak boleh hampa")
    }
    konst konteks_baru = WebauthnPasskeysReaktif(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

