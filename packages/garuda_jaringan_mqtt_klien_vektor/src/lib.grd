modul MqttKlienVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriMqttKlienVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur MqttKlienVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriMqttKlienVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): MqttKlienVektor {
    kembalikan MqttKlienVektor(
        identitas_modul = "MqttKlienVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: MqttKlienVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: MqttKlienVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_mqtt_klien_vektor(konteks: MqttKlienVektor, parameter: Teks): Hasil[MqttKlienVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_mqtt_klien_vektor tidak boleh hampa")
    }
    konst konteks_baru = MqttKlienVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

