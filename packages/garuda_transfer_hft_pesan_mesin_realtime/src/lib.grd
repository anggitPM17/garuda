modul HftPesanMesinRealtime

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHftPesanMesinRealtime {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HftPesanMesinRealtime {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHftPesanMesinRealtime],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HftPesanMesinRealtime {
    kembalikan HftPesanMesinRealtime(
        identitas_modul = "HftPesanMesinRealtime",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HftPesanMesinRealtime): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HftPesanMesinRealtime): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_hft_pesan_mesin_realtime(konteks: HftPesanMesinRealtime, parameter: Teks): Hasil[HftPesanMesinRealtime, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_hft_pesan_mesin_realtime tidak boleh hampa")
    }
    konst konteks_baru = HftPesanMesinRealtime(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

