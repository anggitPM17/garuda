modul HaversineJarakVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriHaversineJarakVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur HaversineJarakVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriHaversineJarakVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): HaversineJarakVektor {
    kembalikan HaversineJarakVektor(
        identitas_modul = "HaversineJarakVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: HaversineJarakVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: HaversineJarakVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_haversine_jarak_vektor(konteks: HaversineJarakVektor, parameter: Teks): Hasil[HaversineJarakVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_haversine_jarak_vektor tidak boleh hampa")
    }
    konst konteks_baru = HaversineJarakVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

