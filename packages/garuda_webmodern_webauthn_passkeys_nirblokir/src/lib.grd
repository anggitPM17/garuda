modul WebauthnPasskeysNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriWebauthnPasskeysNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur WebauthnPasskeysNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriWebauthnPasskeysNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): WebauthnPasskeysNirblokir {
    kembalikan WebauthnPasskeysNirblokir(
        identitas_modul = "WebauthnPasskeysNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: WebauthnPasskeysNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: WebauthnPasskeysNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_webauthn_passkeys_nirblokir(konteks: WebauthnPasskeysNirblokir, parameter: Teks): Hasil[WebauthnPasskeysNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_webauthn_passkeys_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = WebauthnPasskeysNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

