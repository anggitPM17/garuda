modul ReduksiParalelKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriReduksiParalelKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur ReduksiParalelKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriReduksiParalelKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): ReduksiParalelKilat {
    kembalikan ReduksiParalelKilat(
        identitas_modul = "ReduksiParalelKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: ReduksiParalelKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: ReduksiParalelKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_reduksi_paralel_kilat(konteks: ReduksiParalelKilat, parameter: Teks): Hasil[ReduksiParalelKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_reduksi_paralel_kilat tidak boleh hampa")
    }
    konst konteks_baru = ReduksiParalelKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

