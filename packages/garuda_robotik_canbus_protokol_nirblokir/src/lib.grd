modul CanbusProtokolNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriCanbusProtokolNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur CanbusProtokolNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriCanbusProtokolNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): CanbusProtokolNirblokir {
    kembalikan CanbusProtokolNirblokir(
        identitas_modul = "CanbusProtokolNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: CanbusProtokolNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: CanbusProtokolNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_canbus_protokol_nirblokir(konteks: CanbusProtokolNirblokir, parameter: Teks): Hasil[CanbusProtokolNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_canbus_protokol_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = CanbusProtokolNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

