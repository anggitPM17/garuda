modul PemantauDirektoriNirblokir

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPemantauDirektoriNirblokir {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PemantauDirektoriNirblokir {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPemantauDirektoriNirblokir],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PemantauDirektoriNirblokir {
    kembalikan PemantauDirektoriNirblokir(
        identitas_modul = "PemantauDirektoriNirblokir",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PemantauDirektoriNirblokir): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PemantauDirektoriNirblokir): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_pemantau_direktori_nirblokir(konteks: PemantauDirektoriNirblokir, parameter: Teks): Hasil[PemantauDirektoriNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_pemantau_direktori_nirblokir tidak boleh hampa")
    }
    konst konteks_baru = PemantauDirektoriNirblokir(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

publik fungsi eksekusi_nirblokir(konteks: PemantauDirektoriNirblokir, parameter: Teks): Hasil[PemantauDirektoriNirblokir, Teks] {
    jika (parameter.panjang() == 0) {
