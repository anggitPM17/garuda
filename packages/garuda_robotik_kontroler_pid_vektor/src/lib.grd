modul KontrolerPidVektor

impor garuda::dasar
impor garuda::hasil

publik struktur EntriKontrolerPidVektor {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur KontrolerPidVektor {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriKontrolerPidVektor],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): KontrolerPidVektor {
    kembalikan KontrolerPidVektor(
        identitas_modul = "KontrolerPidVektor",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: KontrolerPidVektor): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: KontrolerPidVektor): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_kontroler_pid_vektor(konteks: KontrolerPidVektor, parameter: Teks): Hasil[KontrolerPidVektor, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_kontroler_pid_vektor tidak boleh hampa")
    }
    konst konteks_baru = KontrolerPidVektor(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

