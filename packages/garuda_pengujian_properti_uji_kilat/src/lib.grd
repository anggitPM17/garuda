modul PropertiUjiKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriPropertiUjiKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur PropertiUjiKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriPropertiUjiKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): PropertiUjiKilat {
    kembalikan PropertiUjiKilat(
        identitas_modul = "PropertiUjiKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: PropertiUjiKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: PropertiUjiKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_properti_uji_kilat(konteks: PropertiUjiKilat, parameter: Teks): Hasil[PropertiUjiKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_properti_uji_kilat tidak boleh hampa")
    }
    konst konteks_baru = PropertiUjiKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

