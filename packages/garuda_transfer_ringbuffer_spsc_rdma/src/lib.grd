modul RingbufferSpscRdma

impor garuda::dasar
impor garuda::hasil

publik struktur EntriRingbufferSpscRdma {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur RingbufferSpscRdma {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriRingbufferSpscRdma],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): RingbufferSpscRdma {
    kembalikan RingbufferSpscRdma(
        identitas_modul = "RingbufferSpscRdma",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: RingbufferSpscRdma): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: RingbufferSpscRdma): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_ringbuffer_spsc_rdma(konteks: RingbufferSpscRdma, parameter: Teks): Hasil[RingbufferSpscRdma, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_ringbuffer_spsc_rdma tidak boleh hampa")
    }
    konst konteks_baru = RingbufferSpscRdma(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

