modul BlasMatriksJarangKilat

impor garuda::dasar
impor garuda::hasil

publik struktur EntriBlasMatriksJarangKilat {
    kunci: Teks,
    bobot_prioritas: Bulat,
    muatan_data: Teks
}

publik struktur BlasMatriksJarangKilat {
    identitas_modul: Teks,
    kapasitas_maksimal: Bulat,
    jumlah_elemen: Bulat,
    daftar_entri: Daftar[EntriBlasMatriksJarangKilat],
    status_siap: Kebenaran,
    stempel_audit: Bulat
}

publik fungsi inisialisasi(): BlasMatriksJarangKilat {
    kembalikan BlasMatriksJarangKilat(
        identitas_modul = "BlasMatriksJarangKilat",
        kapasitas_maksimal = 256,
        jumlah_elemen = 0,
        daftar_entri = [],
        status_siap = benar,
        stempel_audit = 1793898000
    )
}

publik fungsi ukuran(s: BlasMatriksJarangKilat): Bulat {
    kembalikan s.jumlah_elemen
}

publik fungsi apakah_kosong(s: BlasMatriksJarangKilat): Kebenaran {
    kembalikan s.jumlah_elemen == 0
}

publik fungsi buat_blas_matriks_jarang_kilat(konteks: BlasMatriksJarangKilat, parameter: Teks): Hasil[BlasMatriksJarangKilat, Teks] {
    jika (parameter.panjang() == 0) {
        kembalikan Gagal("Parameter untuk fungsi buat_blas_matriks_jarang_kilat tidak boleh hampa")
    }
    konst konteks_baru = BlasMatriksJarangKilat(
        identitas_modul = konteks.identitas_modul,
        kapasitas_maksimal = konteks.kapasitas_maksimal,
        jumlah_elemen = konteks.jumlah_elemen + 1,
        status_siap = benar,
        stempel_audit = 1793898000
    )
    kembalikan Sukses(konteks_baru)
}

