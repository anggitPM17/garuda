modul Web

# Modul Web Framework Bahasa Garuda (std/web.grd)
# Lapisan routing dinamis & handler Garuda di atas HttpServer

# Daftarkan kode Garuda sebagai handler
fungsi daftar_handler(Nama, Kode) ->
    HttpServer.daftar_handler(Nama, Kode)
rampung

# Daftarkan route (method, path, handler_name)
fungsi daftar_route(Method, Path, Handler) ->
    HttpServer.daftar_route(Method, Path, Handler)
rampung

# Jalankan server dengan route dinamis yang sudah didaftarkan
fungsi jalankan(Port) ->
    HttpServer.jalankan(Port)
rampung

# Shorthand untuk route GET
fungsi get(Path, Handler) ->
    HttpServer.daftar_route("GET", Path, Handler)
rampung

# Shorthand untuk route POST
fungsi post(Path, Handler) ->
    HttpServer.daftar_route("POST", Path, Handler)
rampung
