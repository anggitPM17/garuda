modul Map

# Modul Manipulasi Peta/Kamus Bahasa Garuda (std/map.grd)

fungsi baru() ->
    Map.baru()
rampung

fungsi taruh(Peta, Kunci, Nilai) ->
    Map.taruh(Peta, Kunci, Nilai)
rampung

fungsi ambil(Peta, Kunci) ->
    Map.ambil(Peta, Kunci)
rampung

fungsi hapus(Peta, Kunci) ->
    Map.hapus(Peta, Kunci)
rampung

fungsi panjang(Peta) ->
    Map.panjang(Peta)
rampung
