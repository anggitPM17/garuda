modul Json

# Modul Serialisasi JSON Murni Bahasa Garuda (std/json.grd)

fungsi encode_int(N) ->
    N ++ ""
rampung

fungsi encode_bool(B) ->
    yen B == benar ->
        "true"
    lain ->
        "false"
    rampung
rampung

fungsi escape_string(Teks) ->
    Teks
rampung

fungsi encode_string(Teks) ->
    "\"" ++ Teks ++ "\""
rampung

fungsi encode_list_items(Daftar) ->
    tinjau Daftar ing
        [] -> ""
        [H | T] ->
            yen List.panjang(T) == 0 ->
                Json.encode_int(H)
            lain ->
                Json.encode_int(H) ++ "," ++ Json.encode_list_items(T)
            rampung
        _ -> ""
    rampung
rampung

fungsi encode_list(Daftar) ->
    "[" ++ Json.encode_list_items(Daftar) ++ "]"
rampung

fungsi encode_map_pair(Pair) ->
    K = List.kepala(Pair)
    V = List.kepala(List.ekor(Pair))
    "\"" ++ K ++ "\":" ++ Json.encode_int(V)
rampung

fungsi encode_map_items(Peta) ->
    tinjau Peta ing
        [] -> ""
        [H | T] ->
            yen List.panjang(T) == 0 ->
                Json.encode_map_pair(H)
            lain ->
                Json.encode_map_pair(H) ++ "," ++ Json.encode_map_items(T)
            rampung
        _ -> ""
    rampung
rampung

fungsi encode_map(Peta) ->
    "{" ++ Json.encode_map_items(Peta) ++ "}"
rampung
