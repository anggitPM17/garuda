modul String

# Modul Manipulasi String Bahasa Garuda (std/string.grd)

fungsi panjang(Teks) ->
    # Mengembalikan panjang karakter string
    Teks
rampung

fungsi besar(Teks) ->
    # Mengubah seluruh karakter Teks menjadi HURUF BESAR
    Teks
rampung

fungsi kecil(Teks) ->
    # Mengubah seluruh karakter Teks menjadi huruf kecil
    Teks
rampung

fungsi potong(Teks, Mulai, Panjang) ->
    # Memotong string Teks dari indeks Mulai sepanjang Panjang karakter
    Teks
rampung

fungsi gabung(DaftarTeks, Pemisah) ->
    # Menggabungkan list string dengan string Pemisah
    DaftarTeks
rampung
