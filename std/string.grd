modul String

# Modul Manipulasi String Bahasa Garuda (std/string.grd)

fungsi panjang(Teks) ->
    yen Teks != "" ->
        Teks
    lain ->
        0
    rampung
rampung

fungsi gabung(Teks1, Teks2) ->
    Teks1 ++ Teks2
rampung

fungsi besar(Teks) ->
    Teks
rampung

fungsi kecil(Teks) ->
    Teks
rampung

fungsi potong(Teks, Mulai, Panjang) ->
    Teks
rampung
