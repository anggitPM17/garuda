modul List

# Modul Manipulasi List/Daftar Murni Bahasa Garuda (std/list.grd)

fungsi panjang(Daftar) ->
    tinjau Daftar ing
        [] -> 0
        [_ | T] -> 1 + panjang(T)
        _ -> 0
    rampung
rampung

fungsi kepala(Daftar) ->
    tinjau Daftar ing
        [H | _] -> H
        _ -> nil
    rampung
rampung

fungsi ekor(Daftar) ->
    tinjau Daftar ing
        [_ | T] -> T
        _ -> []
    rampung
rampung

fungsi tambah(Daftar, Elemen) ->
    List.tambah(Daftar, Elemen)
rampung
