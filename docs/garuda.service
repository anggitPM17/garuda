[Unit]
Description=Garuda GVM Production Engine (BEAM-Core)
After=network.target remote-fs.target
Wants=network-online.target

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/opt/garuda
ExecStart=/opt/garuda/bin/richat_garuda_server
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
WatchdogSec=10s

# Resource Limits for Million-Connection Concurrency
LimitNOFILE=1048576
LimitNPROC=524288
LimitMEMLOCK=infinity

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
