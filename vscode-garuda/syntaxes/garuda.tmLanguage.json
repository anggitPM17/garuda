{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Garuda",
  "scopeName": "source.garuda",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#atoms" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.garuda",
          "match": "--.*$"
        },
        {
          "name": "comment.line.number-sign.garuda",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.garuda",
          "match": "\\b(modul|defmodule|fungsi|def|makro|macro|rampung|end|yen|if|lain|else|tinjau|case|ing|in|ketika|when|tampa|receive|setelah|after)\\b"
        },
        {
          "name": "keyword.other.concurrency.garuda",
          "match": "\\b(cakra|spawn|kirim|send|musnah|kill|pengawas|supervisor|anak|child|strategi|strategy|diri|self)\\b"
        },
        {
          "name": "keyword.other.io.garuda",
          "match": "\\b(cetak|puts)\\b"
        },
        {
          "name": "constant.language.boolean.garuda",
          "match": "\\b(benar|salah|true|false)\\b"
        },
        {
          "name": "constant.language.nil.garuda",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "name": "constant.other.symbol.atom.garuda",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.garuda",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.garuda",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.garuda",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.garuda",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.garuda",
          "match": "(<-|->|\\+\\+|==|!=|<=|>=|\\+|-|\\*|/|=|<|>|\\|)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fungsi|def|makro|macro)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.garuda" },
            "2": { "name": "entity.name.function.garuda" }
          }
        }
      ]
    }
  }
}
