{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Garuda",
  "scopeName": "source.garuda",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#keywords-control" },
    { "include": "#storage" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#atoms" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.garuda",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.garuda",
          "match": "\\b(yen|lain|tinjau|ing|nalika|ketika|tampa|setelah|coba|tangkap|rampung)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.other.garuda",
          "match": "\\b(modul|fungsi|makro|impor|cakra|diri|kirim|musnah|pengawas|anak|strategi)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.garuda",
          "match": "\\b(benar|salah|nil|true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.garuda",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.garuda",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolation.garuda",
              "begin": "#\\{",
              "end": "\\}",
              "patterns": [
                { "include": "source.garuda" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.garuda",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.garuda",
          "match": "\\b(0x[0-9a-fA-F]+|0b[01]+|\\d+(\\.\\d+)?)\\b"
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "name": "constant.language.atom.garuda",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.garuda",
          "match": "(\\|>|->|<-|==|!=|<=|>=|\\+\\+|\\+|-|\\*|/|=|<|>)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.garuda",
          "match": "\\b([A-Z][a-zA-Z0-9_]*\\.[a-z][a-zA-Z0-9_]*)\\b"
        }
      ]
    }
  }
}
