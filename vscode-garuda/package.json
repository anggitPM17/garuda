{
  "name": "garuda",
  "displayName": "Garuda Language",
  "description": "Syntax highlighting dan task runner untuk Bahasa Garuda",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "garuda",
        "aliases": ["Garuda", "garuda"],
        "extensions": [".grd"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "garuda",
        "scopeName": "source.garuda",
        "path": "./syntaxes/garuda.tmLanguage.json"
      }
    ]
  }
}
