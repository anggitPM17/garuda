# ============================================================
# Garuda BEAM — .gitignore (production-ready)
# ============================================================

# Build directories & artifacts
build/
build-*/
out/
bin/
obj/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.dylib
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
Makefile
*.ninja
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln

# IDE & Editor files
.vs/
.vscode/
.idea/
*.user
*.suo
*.swp
*.swo
*.code-workspace

# Caches & Temp
.cache/
ccache/
.tmp/
temp/

# Databases & Storage
*.db
*.sqlite
*.sqlite3
*.mnesia
*.state
*.sql
richat_db/
garuda_db/
garuda_richat_db/
test_*_db/
test_*_dir/
richat_production_data/
var/

# Logs & Archives
*.log
logs/
journal/
*.tar.gz
*.tar.bz2
*.zip
*.7z
test_*.txt
scratch/

# Environment & Secrets
.env
.env.*
*.key
*.pem
*.p12
*.jks
*.keystore
secrets/

# Test Outputs
test_results/
*.test.log
*.junit.xml
coverage/

# OS Specific
.DS_Store
Thumbs.db
desktop.ini

# Backup Folders
backup/
richat-backup/

# Erlang & Elixir Legacy (Guard)
_build/
deps/
rel/
*.erl
*.hrl
rebar.config
rebar.lock
mix.exs
mix.lock

# Android & Mobile Client
android/
app/
RichatAndroid/
*.apk
*.aab
gradle/
gradlew
gradlew.bat

# RICHAT Application Layer (Excluded for Pure Garuda BEAM Engine)
include/garuda/richat/
src/richat_*
tests/test_richat_*
docs/*CHAT*
docs/*MIGRATION*
docs/RICHAT_*

# Python Legacy (Guard)
__pycache__/
*.pyc
venv/
.venv/
